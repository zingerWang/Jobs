digraph G {
graph [rankdir=TB, newrank=true, bgcolor="white", pad="0.3", nodesep="0.25", ranksep="0.5", ordering=out, dpi=200, fontname="PingFang SC", labelloc=t, label=<<B><FONT POINT-SIZE="24" COLOR="#1E293B">懒标记：总账先更新，查明细时再下传</FONT></B><BR/><FONT POINT-SIZE="13" COLOR="#64748B">数组 [2,1,3,4] 整段加 5；sum 已生效，lazy 是尚未交给孩子的加法</FONT>>];
node [shape=plaintext, fontname="PingFang SC", fontsize=13];
edge [fontname="PingFang SC", fontsize=11, color="#0284C7", fontcolor="#0284C7", arrowsize=0.7, penwidth=1.4];
subgraph cluster_a { label="① 整段更新后"; fontcolor="#475569"; fontsize=15; color="#CBD5E1"; style=rounded;
ar [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#D97706"><FONT COLOR="white"><B>[0,4) sum=30</B></FONT></TD></TR><TR><TD BGCOLOR="#FFFBEB"><FONT COLOR="#1E293B" POINT-SIZE="12">lazy=5</FONT></TD></TR></TABLE>>];
al [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#475569"><FONT COLOR="white"><B>[0,2) sum=3</B></FONT></TD></TR><TR><TD BGCOLOR="#F8FAFC"><FONT COLOR="#1E293B" POINT-SIZE="12">lazy=0；仍是旧值</FONT></TD></TR></TABLE>>];
arr [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#475569"><FONT COLOR="white"><B>[2,4) sum=7</B></FONT></TD></TR><TR><TD BGCOLOR="#F8FAFC"><FONT COLOR="#1E293B" POINT-SIZE="12">lazy=0；仍是旧值</FONT></TD></TR></TABLE>>];
ar -> al [color="#0284C7", fontcolor="#0284C7", label="尚未下传"];
ar -> arr [color="#0284C7", fontcolor="#0284C7", label="尚未下传"];
}
subgraph cluster_b { label="② 查左半段前先 push"; fontcolor="#475569"; fontsize=15; color="#CBD5E1"; style=rounded;
br [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#0D9488"><FONT COLOR="white"><B>[0,4) sum=30</B></FONT></TD></TR><TR><TD BGCOLOR="#F0FDFA"><FONT COLOR="#1E293B" POINT-SIZE="12">lazy=0</FONT></TD></TR></TABLE>>];
bl [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#0D9488"><FONT COLOR="white"><B>[0,2) sum=13</B></FONT></TD></TR><TR><TD BGCOLOR="#F0FDFA"><FONT COLOR="#1E293B" POINT-SIZE="12">lazy=5</FONT></TD></TR></TABLE>>];
brr [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#0D9488"><FONT COLOR="white"><B>[2,4) sum=17</B></FONT></TD></TR><TR><TD BGCOLOR="#F0FDFA"><FONT COLOR="#1E293B" POINT-SIZE="12">lazy=5</FONT></TD></TR></TABLE>>];
br -> bl [color="#0284C7", fontcolor="#0284C7", label="3 + 5×2"];
br -> brr [color="#0284C7", fontcolor="#0284C7", label="7 + 5×2"];
}
{rank=same; ar; br;}
}
