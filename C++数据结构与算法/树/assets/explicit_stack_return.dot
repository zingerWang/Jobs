digraph G {
graph [rankdir=LR, bgcolor="white", dpi=200, pad=0.3, nodesep=0.4, ranksep=0.6, fontname="PingFang SC", labelloc=t, label=<<FONT POINT-SIZE="24" COLOR="#1E293B"><B>孩子退出后，父结点从哪里继续？</B></FONT><BR/><FONT POINT-SIZE="13" COLOR="#64748B">栈帧按底 → 顶列出；next 是下一条邻接边的下标</FONT>>];
node [shape=plaintext,fontname="PingFang SC"];
edge [fontname="PingFang SC",fontsize=11,color="#0284C7",fontcolor="#0284C7",arrowsize=0.7];
a [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#7C3AED"><FONT COLOR="white" POINT-SIZE="15"><B>① 压入孩子 3</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5F3FF"><FONT COLOR="#1E293B" POINT-SIZE="12">栈：0 → 1 → 3<BR ALIGN="LEFT"/>g[1] = [0, 3, 4]<BR ALIGN="LEFT"/>帧 1：next = 2<BR ALIGN="LEFT"/>父帧已经记住：下一次处理 4</FONT></TD></TR></TABLE>>];
b [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0D9488"><FONT COLOR="white" POINT-SIZE="15"><B>② 孩子 3 完成</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0FDFA"><FONT COLOR="#1E293B" POINT-SIZE="12">3 的孩子 5 已先退出<BR ALIGN="LEFT"/>size[3] = 2<BR ALIGN="LEFT"/>弹出帧 3；size[1] 从 1 加到 3<BR ALIGN="LEFT"/>栈：0 → 1</FONT></TD></TR></TABLE>>];
c [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white" POINT-SIZE="15"><B>③ 父亲继续访问 4</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F9FF"><FONT COLOR="#1E293B" POINT-SIZE="12">从 g[1][2] 取出孩子 4<BR ALIGN="LEFT"/>先把帧 1 的 next 改为 3<BR ALIGN="LEFT"/>再压入帧 4；栈：0 → 1 → 4<BR ALIGN="LEFT"/>4 返回后，size[1] = 4</FONT></TD></TR></TABLE>>];
a -> b [label="不是立即处理父亲
先完成孩子的工作"];
b -> c [label="恢复父帧 next
不重新访问 3"];
}