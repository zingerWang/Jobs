b [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#7C3AED"><FONT COLOR="white"><B>有序查找</B></FONT></TD></TR><TR><TD BGCOLOR="#F5F3FF"><TABLE BORDER="0" CELLBORDER="0"><TR><TD ALIGN="LEFT">BST：大小关系</TD></TR><TR><TD ALIGN="LEFT">AVL／红黑：最坏对数</TD></TR><TR><TD ALIGN="LEFT">Treap：期望；Splay：均摊</TD></TR></TABLE></TD></TR></TABLE>>];
