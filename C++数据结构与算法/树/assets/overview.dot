d [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#0D9488"><FONT COLOR="white"><B>字符串与集合</B></FONT></TD></TR><TR><TD BGCOLOR="#F0FDFA"><TABLE BORDER="0" CELLBORDER="0"><TR><TD ALIGN="LEFT">Trie：前缀复用</TD></TR><TR><TD ALIGN="LEFT">AC：多模式匹配</TD></TR><TR><TD ALIGN="LEFT">DSU：合并；KD：空间</TD></TR></TABLE></TD></TR></TABLE>>];
