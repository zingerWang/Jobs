digraph G { graph [rankdir=LR, bgcolor="white", pad="0.35", nodesep="0.4", ranksep="0.65", ordering=out, dpi=200, fontname="PingFang SC", labelloc=t, label=<<B><FONT POINT-SIZE="24" COLOR="#1E293B">树数据结构：按任务理解</FONT></B><BR/><FONT POINT-SIZE="13" COLOR="#64748B">先识别任务，再选择不变量、操作和实现</FONT>>]; node [shape=plaintext, fontname="PingFang SC", fontsize=13]; edge [fontname="PingFang SC", fontsize=11, color="#64748B", penwidth=1.5, arrowsize=0.8];
