digraph G { graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.4", ranksep="0.65", ordering=out, dpi=200, fontname="Microsoft YaHei", labelloc=t, label=<<B><FONT POINT-SIZE="24" COLOR="#1E293B">点分治：先查询，再加入频次</FONT></B><BR/><FONT POINT-SIZE="12" COLOR="#64748B">例：K=3；只在当前层统计经过重心的路径</FONT>>]; node [shape=plaintext, fontname="Microsoft YaHei", fontsize=13]; edge [fontname="Microsoft YaHei", fontsize=11, color="#64748B", penwidth=1.5, arrowsize=0.8];
c [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#7C3AED"><FONT COLOR="white"><B>重心 c</B></FONT></TD></TR><TR><TD BGCOLOR="#F5F3FF"><TABLE BORDER="0" CELLBORDER="0"><TR><TD ALIGN="LEFT">freq[0] = 1</TD></TR></TABLE></TD></TR></TABLE>>];
a [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white"><B>已处理分量 A</B></FONT></TD></TR><TR><TD BGCOLOR="#F0F9FF"><TABLE BORDER="0" CELLBORDER="0"><TR><TD ALIGN="LEFT">到 c 的距离：1、2</TD></TR><TR><TD ALIGN="LEFT">freq[1]=1，freq[2]=1</TD></TR></TABLE></TD></TR></TABLE>>];
b [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#0D9488"><FONT COLOR="white"><B>当前分量 B</B></FONT></TD></TR><TR><TD BGCOLOR="#F0FDFA"><TABLE BORDER="0" CELLBORDER="0"><TR><TD ALIGN="LEFT">某点到 c 距离为 1</TD></TR><TR><TD ALIGN="LEFT">查询 freq[3−1]，得到 1 个配对</TD></TR></TABLE></TD></TR></TABLE>>];
d [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#D97706"><FONT COLOR="white"><B>当前分量处理完后</B></FONT></TD></TR><TR><TD BGCOLOR="#FFFBEB"><TABLE BORDER="0" CELLBORDER="0"><TR><TD ALIGN="LEFT">再将 B 的距离加入 freq</TD></TR><TR><TD ALIGN="LEFT">同分量内部路径交给递归</TD></TR></TABLE></TD></TR></TABLE>>];
c -> a [label=""];
c -> b [label=""];
b -> d [label="先查，再加"];

}