digraph G { graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.4", ranksep="0.65", ordering=out, dpi=200, fontname="Microsoft YaHei", labelloc=t, label=<<B><FONT POINT-SIZE="24" COLOR="#1E293B">KD-Tree：先近侧，再判断远侧</FONT></B><BR/><FONT POINT-SIZE="12" COLOR="#64748B">二维交替按 x、y 切分；最近邻不能永远只访问一侧</FONT>>]; node [shape=plaintext, fontname="Microsoft YaHei", fontsize=13]; edge [fontname="Microsoft YaHei", fontsize=11, color="#64748B", penwidth=1.5, arrowsize=0.8];
r [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#7C3AED"><FONT COLOR="white"><B>按 x = 5 切分</B></FONT></TD></TR><TR><TD BGCOLOR="#F5F3FF"><TABLE BORDER="0" CELLBORDER="0"><TR><TD ALIGN="LEFT">目标点 x ≥ 5，先搜右侧</TD></TR></TABLE></TD></TR></TABLE>>];
l [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white"><B>左侧：x &lt; 5</B></FONT></TD></TR><TR><TD BGCOLOR="#F0F9FF"><TABLE BORDER="0" CELLBORDER="0"><TR><TD ALIGN="LEFT">下一层按 y 切分</TD></TR></TABLE></TD></TR></TABLE>>];
q [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#0D9488"><FONT COLOR="white"><B>右侧：x ≥ 5</B></FONT></TD></TR><TR><TD BGCOLOR="#F0FDFA"><TABLE BORDER="0" CELLBORDER="0"><TR><TD ALIGN="LEFT">先找当前最近候选</TD></TR></TABLE></TD></TR></TABLE>>];
check [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#D97706"><FONT COLOR="white"><B>是否还需搜索左侧？</B></FONT></TD></TR><TR><TD BGCOLOR="#FFFBEB"><TABLE BORDER="0" CELLBORDER="0"><TR><TD ALIGN="LEFT">比较 (目标 x − 5)² 与当前最佳距离平方</TD></TR><TR><TD ALIGN="LEFT">平面仍可能更近时，必须回到远侧</TD></TR></TABLE></TD></TR></TABLE>>];
r -> l [label="远侧"];
r -> q [label="近侧"];
q -> check [label="更新 best"];
check -> l [label="必要时访问",style=dashed,constraint=false];

}