digraph G {
graph [rankdir=LR, newrank=true, bgcolor="white", pad="0.3", nodesep="0.25", ranksep="0.5", ordering=out, dpi=200, fontname="PingFang SC", labelloc=t, label=<<B><FONT POINT-SIZE="24" COLOR="#1E293B">树数据结构面试指南</FONT></B><BR/><FONT POINT-SIZE="13" COLOR="#64748B">从关系与遍历出发，按实际问题选择结构，再用例子验证</FONT>>];
node [shape=plaintext, fontname="PingFang SC", fontsize=13];
edge [fontname="PingFang SC", fontsize=11, color="#0284C7", fontcolor="#0284C7", arrowsize=0.7, penwidth=1.4];
root [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#4F46E5"><FONT COLOR="white"><B>树数据结构面试指南</B></FONT></TD></TR><TR><TD BGCOLOR="#EEF2FF"><FONT COLOR="#1E293B" POINT-SIZE="12">先问任务，再看规则<BR/>例子 → 过程 → 复杂度 → 边界</FONT></TD></TR></TABLE>>];
base [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white"><B>1～3 基础与查找</B></FONT></TD></TR></TABLE>>];
root -> base [color="#0284C7", fontcolor="#0284C7"];
base0 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#0D9488"><FONT COLOR="white"><B>关系与存储</B></FONT></TD></TR><TR><TD BGCOLOR="#F0FDFA"><FONT COLOR="#1E293B" POINT-SIZE="12">根、子树、深度与高度<BR/>指针、数组、邻接表</FONT></TD></TR></TABLE>>];
base -> base0 [color="#0284C7", fontcolor="#0284C7"];
base1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#0D9488"><FONT COLOR="white"><B>访问与排除</B></FONT></TD></TR><TR><TD BGCOLOR="#F0FDFA"><FONT COLOR="#1E293B" POINT-SIZE="12">DFS／BFS 访问所有点<BR/>BST 按键排除一边</FONT></TD></TR></TABLE>>];
base -> base1 [color="#0284C7", fontcolor="#0284C7"];
heap [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white"><B>4 极值与优先级</B></FONT></TD></TR></TABLE>>];
root -> heap [color="#0284C7", fontcolor="#0284C7"];
heap0 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#0D9488"><FONT COLOR="white"><B>堆</B></FONT></TD></TR><TR><TD BGCOLOR="#F0FDFA"><FONT COLOR="#1E293B" POINT-SIZE="12">完全二叉树＋父子堆序<BR/>上浮、下沉、线性建堆</FONT></TD></TR></TABLE>>];
heap -> heap0 [color="#0284C7", fontcolor="#0284C7"];
heap1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#0D9488"><FONT COLOR="white"><B>应用</B></FONT></TD></TR><TR><TD BGCOLOR="#F0FDFA"><FONT COLOR="#1E293B" POINT-SIZE="12">Top K 保留候选<BR/>哈夫曼反复合并最小项</FONT></TD></TR></TABLE>>];
heap -> heap1 [color="#0284C7", fontcolor="#0284C7"];
balance [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white"><B>5～8 控制查找成本</B></FONT></TD></TR></TABLE>>];
root -> balance [color="#0284C7", fontcolor="#0284C7"];
balance0 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#0D9488"><FONT COLOR="white"><B>旋转与确定性平衡</B></FONT></TD></TR><TR><TD BGCOLOR="#F0FDFA"><FONT COLOR="#1E293B" POINT-SIZE="12">保持中序顺序<BR/>AVL 高度差／红黑树黑高</FONT></TD></TR></TABLE>>];
balance -> balance0 [color="#0284C7", fontcolor="#0284C7"];
balance1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#0D9488"><FONT COLOR="white"><B>另外两种保证</B></FONT></TD></TR><TR><TD BGCOLOR="#F0FDFA"><FONT COLOR="#1E293B" POINT-SIZE="12">Treap：随机化期望对数<BR/>Splay：操作序列均摊对数</FONT></TD></TR></TABLE>>];
balance -> balance1 [color="#0284C7", fontcolor="#0284C7"];
special [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white"><B>9～11 按任务组织数据</B></FONT></TD></TR></TABLE>>];
root -> special [color="#0284C7", fontcolor="#0284C7"];
special0 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#0D9488"><FONT COLOR="white"><B>页与字符串</B></FONT></TD></TR><TR><TD BGCOLOR="#F0FDFA"><FONT COLOR="#1E293B" POINT-SIZE="12">B／B+：分裂、导航、叶链<BR/>Trie／AC：前缀与 fail</FONT></TD></TR></TABLE>>];
special -> special0 [color="#0284C7", fontcolor="#0284C7"];
special1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#0D9488"><FONT COLOR="white"><B>集合与空间</B></FONT></TD></TR><TR><TD BGCOLOR="#F0FDFA"><FONT COLOR="#1E293B" POINT-SIZE="12">DSU：代表元与合并<BR/>KD-Tree：距离下界剪枝</FONT></TD></TR></TABLE>>];
special -> special1 [color="#0284C7", fontcolor="#0284C7"];
interval [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white"><B>12 数组区间</B></FONT></TD></TR></TABLE>>];
root -> interval [color="#0284C7", fontcolor="#0284C7"];
interval0 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#0D9488"><FONT COLOR="white"><B>可修改的数据</B></FONT></TD></TR><TR><TD BGCOLOR="#F0FDFA"><FONT COLOR="#1E293B" POINT-SIZE="12">线段树：聚合与懒标记<BR/>BIT：前缀、lowbit、差分</FONT></TD></TR></TABLE>>];
interval -> interval0 [color="#0284C7", fontcolor="#0284C7"];
interval1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#0D9488"><FONT COLOR="white"><B>静态与历史数据</B></FONT></TD></TR><TR><TD BGCOLOR="#F0FDFA"><FONT COLOR="#1E293B" POINT-SIZE="12">ST 表：幂等区间合并<BR/>持久化：复制路径保留版本</FONT></TD></TR></TABLE>>];
interval -> interval1 [color="#0284C7", fontcolor="#0284C7"];
treeops [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white"><B>13～14 输入本来是树</B></FONT></TD></TR></TABLE>>];
root -> treeops [color="#0284C7", fontcolor="#0284C7"];
treeops0 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#0D9488"><FONT COLOR="white"><B>关系转换成数组</B></FONT></TD></TR><TR><TD BGCOLOR="#F0FDFA"><FONT COLOR="#1E293B" POINT-SIZE="12">LCA：倍增跳祖先<BR/>DFS 序／HLD：子树与路径区间</FONT></TD></TR></TABLE>>];
treeops -> treeops0 [color="#0284C7", fontcolor="#0284C7"];
treeops1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#0D9488"><FONT COLOR="white"><B>分解与传递答案</B></FONT></TD></TR><TR><TD BGCOLOR="#F0FDFA"><FONT COLOR="#1E293B" POINT-SIZE="12">重心／点分治：分类统计路径<BR/>树形 DP／换根：复用子树结果</FONT></TD></TR></TABLE>>];
treeops -> treeops1 [color="#0284C7", fontcolor="#0284C7"];
treeops2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#0D9488"><FONT COLOR="white"><B>进阶分支</B></FONT></TD></TR><TR><TD BGCOLOR="#F0FDFA"><FONT COLOR="#1E293B" POINT-SIZE="12">LCT：连边断边后的路径<BR/>DSU on Tree：复用子树计数</FONT></TD></TR></TABLE>>];
treeops -> treeops2 [color="#0284C7", fontcolor="#0284C7"];
practice [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white"><B>15～16 题目与验证</B></FONT></TD></TR></TABLE>>];
root -> practice [color="#0284C7", fontcolor="#0284C7"];
practice0 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#0D9488"><FONT COLOR="white"><B>递归返回值</B></FONT></TD></TR><TR><TD BGCOLOR="#F0FDFA"><FONT COLOR="#1E293B" POINT-SIZE="12">深度／重建／序列化<BR/>最大路径和：候选与返回分开</FONT></TD></TR></TABLE>>];
practice -> practice0 [color="#0284C7", fontcolor="#0284C7"];
practice1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#0D9488"><FONT COLOR="white"><B>复现与选型</B></FONT></TD></TR><TR><TD BGCOLOR="#F0FDFA"><FONT COLOR="#1E293B" POINT-SIZE="12">教学源码／前提／错误边界<BR/>朴素算法对照／不变量检查</FONT></TD></TR></TABLE>>];
practice -> practice1 [color="#0284C7", fontcolor="#0284C7"];
review [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white"><B>Q&amp;A 与复习</B></FONT></TD></TR></TABLE>>];
root -> review [color="#0284C7", fontcolor="#0284C7"];
review0 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#0D9488"><FONT COLOR="white"><B>讲清为什么</B></FONT></TD></TR><TR><TD BGCOLOR="#F0FDFA"><FONT COLOR="#1E293B" POINT-SIZE="12">搜索规则／高度保证<BR/>标记下传／编号与路径</FONT></TD></TR></TABLE>>];
review -> review0 [color="#0284C7", fontcolor="#0284C7"];
review1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#0D9488"><FONT COLOR="white"><B>复述主线</B></FONT></TD></TR><TR><TD BGCOLOR="#F0FDFA"><FONT COLOR="#1E293B" POINT-SIZE="12">解决什么问题 → 保存什么<BR/>省掉什么工作 → 代价是什么</FONT></TD></TR></TABLE>>];
review -> review1 [color="#0284C7", fontcolor="#0284C7"];
}
