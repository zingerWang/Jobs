digraph G {
graph [rankdir=LR, bgcolor="white", dpi=200, pad=0.3, nodesep=0.3, ranksep=0.6, fontname="PingFang SC", labelloc=t, label=<<FONT POINT-SIZE="24" COLOR="#1E293B"><B>消息队列与可靠事件</B></FONT><BR/><FONT POINT-SIZE="13" COLOR="#64748B">与文末文字树使用同一组要点</FONT>>];
node [shape=plaintext, fontname="PingFang SC"];
edge [fontname="PingFang SC", fontsize=11, arrowhead=normal, arrowsize=0.7, color="#0284C7", fontcolor="#0284C7"];
root [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#4F46E5"><FONT COLOR="white" POINT-SIZE="15"><B>消息队列与可靠事件</B></FONT></TD></TR><TR><TD BGCOLOR="#EEF2FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">核心问题 → 机制 → 失败边界 → 验证</FONT></TD></TR></TABLE>>];
n0 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white" POINT-SIZE="15"><B>可靠发送</B></FONT></TD></TR><TR><TD BGCOLOR="#F0F9FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">Outbox 与业务数据同事务<BR ALIGN="LEFT"/>轮询或 CDC 转发，发送仍可能重复</FONT></TD></TR></TABLE>>];
n1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white" POINT-SIZE="15"><B>可靠消费</B></FONT></TD></TR><TR><TD BGCOLOR="#F0F9FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">业务修改与去重记录同事务<BR ALIGN="LEFT"/>完成业务后确认；外部副作用单独协调</FONT></TD></TR></TABLE>>];
n2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white" POINT-SIZE="15"><B>顺序与重平衡</B></FONT></TD></TR><TR><TD BGCOLOR="#F0F9FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">接管从已提交位点继续，可能重投<BR ALIGN="LEFT"/>只提交连续完成位置；旧执行器仍须隔离</FONT></TD></TR></TABLE>>];
n3 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white" POINT-SIZE="15"><B>积压与重放</B></FONT></TD></TR><TR><TD BGCOLOR="#F0F9FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">看最老消息年龄和净消化速率<BR ALIGN="LEFT"/>死信需修复重放，保留原幂等键</FONT></TD></TR></TABLE>>];
n4 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white" POINT-SIZE="15"><B>组件与实验</B></FONT></TD></TR><TR><TD BGCOLOR="#F0F9FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">Kafka、RocketMQ、RabbitMQ 保证范围<BR ALIGN="LEFT"/>在提交和确认之间注入故障</FONT></TD></TR></TABLE>>];
root -> n0;
root -> n1;
root -> n2;
root -> n3;
root -> n4;
}
