g0 -> g0_1 [label="", color="#4F46E5", fontcolor="#4F46E5"];
g0 -> g0_2 [label="", color="#4F46E5", fontcolor="#4F46E5"];
root -> g1 [label="", color="#7C3AED", fontcolor="#7C3AED"];
