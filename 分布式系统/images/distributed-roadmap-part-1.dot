g1 -> g1_1 [label="", color="#7C3AED", fontcolor="#7C3AED"];
g1 -> g1_2 [label="", color="#7C3AED", fontcolor="#7C3AED"];
root -> g2 [label="", color="#0284C7", fontcolor="#0284C7"];
g2 -> g2_0 [label="", color="#0284C7", fontcolor="#0284C7"];
g2 -> g2_1 [label="", color="#0284C7", fontcolor="#0284C7"];
g2 -> g2_2 [label="", color="#0284C7", fontcolor="#0284C7"];

