digraph G {
graph [rankdir=LR, bgcolor="white", dpi=200, pad=0.3, nodesep=0.3, ranksep=0.6, fontname="PingFang SC", labelloc=t, label=<<FONT POINT-SIZE="24" COLOR="#1E293B"><B>法定人数的安全与活性约束</B></FONT><BR/><FONT POINT-SIZE="13" COLOR="#64748B">适用于本文基于交集的模型，不概括所有 BFT 协议</FONT>>];
node [shape=plaintext, fontname="PingFang SC"];
edge [fontname="PingFang SC", fontsize=11, arrowhead=normal, arrowsize=0.7, color="#0284C7", fontcolor="#0284C7"];
a [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white" POINT-SIZE="15"><B>CFT</B></FONT></TD></TR><TR><TD BGCOLOR="#F0F9FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">2q - n &gt;= 1；q &lt;= n-f<BR ALIGN="LEFT"/>因此 n &gt;= 2f+1<BR ALIGN="LEFT"/>最小规模时 q=f+1</FONT></TD></TR></TABLE>>];
b [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#7C3AED"><FONT COLOR="white" POINT-SIZE="15"><B>PBFT 类 BFT</B></FONT></TD></TR><TR><TD BGCOLOR="#F5F3FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">2q - n &gt;= f+1；q &lt;= n-f<BR ALIGN="LEFT"/>因此 n &gt;= 3f+1<BR ALIGN="LEFT"/>最小规模时 q=2f+1</FONT></TD></TR></TABLE>>];
c [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#D97706"><FONT COLOR="white" POINT-SIZE="15"><B>公式之外</B></FONT></TD></TR><TR><TD BGCOLOR="#FFFBEB" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">持久状态、消息证据与选值规则<BR ALIGN="LEFT"/>认证、时序和恢复假设</FONT></TD></TR></TABLE>>];
a -> c;
b -> c;
}
