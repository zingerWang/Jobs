digraph weak_models {
    rankdir=LR;
    compound=true;
    graph [fontname="PingFang SC", bgcolor="white", pad=0.5, nodesep=0.5, ranksep=0.9, label=<<FONT POINT-SIZE="24" COLOR="#1E293B"><B>弱一致性模型：强度递增的阶梯</B></FONT><BR/><FONT POINT-SIZE="13" COLOR="#64748B">越往右保证越强、越好用，但性能与可用性越差——选型就是在两者间找平衡</FONT>>, labelloc=t, fontname="PingFang SC"];
    node [fontname="PingFang SC", shape=plaintext, margin=0];
    edge [fontname="PingFang SC", fontsize=12, penwidth=1.8, arrowsize=0.8];

    eventual [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#7C3AED" COLOR="white" ALIGN="CENTER" CELLPADDING="7"><FONT POINT-SIZE="13"><B>最终一致</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#F5F3FF" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="11" COLOR="#6D28D9">停止写入后最终收敛<BR/>不保证多久 / 读到什么</FONT></TD></TR>
</TABLE>>];

    causal [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#0284C7" COLOR="white" ALIGN="CENTER" CELLPADDING="7"><FONT POINT-SIZE="13"><B>因果一致</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#F0F9FF" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="11" COLOR="#0369A1">有因果的操作保序<BR/>无因果的可乱序</FONT></TD></TR>
</TABLE>>];

    session [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#D97706" COLOR="white" ALIGN="CENTER" CELLPADDING="7"><FONT POINT-SIZE="13"><B>会话保证</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#FFFBEB" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="11" COLOR="#B45309">读己之写 / 单调读<BR/>单调写 / 写后读</FONT></TD></TR>
</TABLE>>];

    strong [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#0D9488" COLOR="white" ALIGN="CENTER" CELLPADDING="7"><FONT POINT-SIZE="13"><B>强一致（线性一致）</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#F0FDFA" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="11" COLOR="#0F766E">写完立刻全局可见<BR/>最贵 · 见第 03 篇</FONT></TD></TR>
</TABLE>>];

    eventual -> causal [color="#94A3B8", label="更强"];
    causal -> session [color="#94A3B8", label="更强"];
    session -> strong [color="#94A3B8", label="更强"];
}
