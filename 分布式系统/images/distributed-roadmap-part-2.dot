g5 -> g5_0 [label="", color="#7C3AED", fontcolor="#7C3AED"];
g5 -> g5_1 [label="", color="#7C3AED", fontcolor="#7C3AED"];
g5 -> g5_2 [label="", color="#7C3AED", fontcolor="#7C3AED"];
root -> g6 [label="", color="#0284C7", fontcolor="#0284C7"];
g6 -> g6_0 [label="", color="#0284C7", fontcolor="#0284C7"];
g6 -> g6_1 [label="", color="#0284C7", fontcolor="#0284C7"];
g6 -> g6_2 [label="", color="#0284C7", fontcolor="#0284C7"];

