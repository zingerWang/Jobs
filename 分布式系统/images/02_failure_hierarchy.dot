digraph failure_hierarchy {
    rankdir=TB;
    compound=true;
    graph [fontname="PingFang SC", bgcolor="white", pad=0.5, nodesep=0.7, ranksep=0.45, label=<<FONT POINT-SIZE="24" COLOR="#1E293B"><B>故障模型：从轻到重的层级</B></FONT><BR/><FONT POINT-SIZE="13" COLOR="#64748B">越往下节点越「不老实」、处理越难；每一级都包含上一级的所有行为</FONT>>, labelloc=t, fontname="PingFang SC"];
    node [fontname="PingFang SC", shape=plaintext, margin=0];
    edge [fontname="PingFang SC", fontsize=12, penwidth=1.6, arrowsize=0.8];

    fs [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#0D9488" COLOR="white" ALIGN="CENTER" CELLPADDING="7"><FONT POINT-SIZE="13"><B>崩溃-停止（Fail-stop）</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#F0FDFA" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="11" COLOR="#0F766E">崩了就静默，不再发消息，行为诚实 · 最友好</FONT></TD></TR>
</TABLE>>];

    cr [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#0284C7" COLOR="white" ALIGN="CENTER" CELLPADDING="7"><FONT POINT-SIZE="13"><B>崩溃-恢复（Crash-recovery）</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#F0F9FF" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="11" COLOR="#0369A1">崩了会重启，但丢失内存状态（失忆）→ 靠持久化</FONT></TD></TR>
</TABLE>>];

    om [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#D97706" COLOR="white" ALIGN="CENTER" CELLPADDING="7"><FONT POINT-SIZE="13"><B>遗漏（Omission）</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#FFFBEB" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="11" COLOR="#B45309">消息可能丢失（发送遗漏 / 接收遗漏）</FONT></TD></TR>
</TABLE>>];

    by [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#E11D48" COLOR="white" ALIGN="CENTER" CELLPADDING="7"><FONT POINT-SIZE="13"><B>拜占庭（Byzantine）</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#FFF1F2" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="11" COLOR="#BE123C">任意行为：撒谎、发矛盾消息、篡改 · 最难</FONT></TD></TR>
</TABLE>>];

    part [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#7C3AED" COLOR="white" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="12"><B>网络分区（Partition）</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#F5F3FF" ALIGN="CENTER" CELLPADDING="5"><FONT POINT-SIZE="11" COLOR="#6D28D9">链路层的「批量遗漏」<BR/>一群节点一起失联 → 脑裂 / CAP 的 P</FONT></TD></TR>
</TABLE>>];

    fs -> cr [label="包含", color="#0284C7", fontcolor="#0369A1"];
    cr -> om [label="包含", color="#D97706", fontcolor="#B45309"];
    om -> by [label="包含", color="#E11D48", fontcolor="#BE123C"];

    om -> part [label="链路层面", color="#7C3AED", fontcolor="#6D28D9", style=dashed, constraint=false];
}
