digraph G {
graph [rankdir=LR, bgcolor="white", dpi=200, pad=0.3, nodesep=0.3, ranksep=0.6, fontname="PingFang SC", labelloc=t, label=<<FONT POINT-SIZE="24" COLOR="#1E293B"><B>分布式锁、租约与 ID</B></FONT><BR/><FONT POINT-SIZE="13" COLOR="#64748B">与文末文字树使用同一组要点</FONT>>];
node [shape=plaintext, fontname="PingFang SC"];
edge [fontname="PingFang SC", fontsize=11, arrowhead=normal, arrowsize=0.7, color="#0284C7", fontcolor="#0284C7"];
root [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#4F46E5"><FONT COLOR="white" POINT-SIZE="15"><B>分布式锁、租约与 ID</B></FONT></TD></TR><TR><TD BGCOLOR="#EEF2FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">核心问题 → 机制 → 失败边界 → 验证</FONT></TD></TR></TABLE>>];
n0 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white" POINT-SIZE="15"><B>锁与租约</B></FONT></TD></TR><TR><TD BGCOLOR="#F0F9FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">持有者标识；条件释放和续租<BR ALIGN="LEFT"/>租约过期不代表旧线程已停</FONT></TD></TR></TABLE>>];
n1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white" POINT-SIZE="15"><B>实现与假设</B></FONT></TD></TR><TR><TD BGCOLOR="#F0F9FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">Redis、ZooKeeper、etcd 的不同协议<BR ALIGN="LEFT"/>Redlock 必须分析时间与暂停假设</FONT></TD></TR></TABLE>>];
n2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white" POINT-SIZE="15"><B>资源端隔离</B></FONT></TD></TR><TR><TD BGCOLOR="#F0F9FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">递增 fencing token 随写入传递<BR ALIGN="LEFT"/>校验与业务写入原子完成</FONT></TD></TR></TABLE>>];
n3 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white" POINT-SIZE="15"><B>分布式 ID</B></FONT></TD></TR><TR><TD BGCOLOR="#F0F9FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">Snowflake 的回拨、节点号和序列容量<BR ALIGN="LEFT"/>号段批量分配；UUID 不等于业务幂等键</FONT></TD></TR></TABLE>>];
n4 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white" POINT-SIZE="15"><B>故障验证</B></FONT></TD></TR><TR><TD BGCOLOR="#F0F9FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">旧持有者暂停，新持有者写入后旧写到达<BR ALIGN="LEFT"/>资源拒绝旧凭证，核对最终值</FONT></TD></TR></TABLE>>];
root -> n0;
root -> n1;
root -> n2;
root -> n3;
root -> n4;
}
