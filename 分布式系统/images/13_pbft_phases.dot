digraph G {
graph [rankdir=TB, bgcolor="white", dpi=200, pad=0.3, nodesep=0.3, ranksep=0.6, fontname="PingFang SC", labelloc=t, label=<<FONT POINT-SIZE="24" COLOR="#1E293B"><B>PBFT：准备、提交与视图切换</B></FONT><BR/><FONT POINT-SIZE="13" COLOR="#64748B">原始 PBFT：n=3f+1，最多 f 个拜占庭副本</FONT>>];
node [shape=plaintext, fontname="PingFang SC"];
edge [fontname="PingFang SC", fontsize=11, arrowhead=normal, arrowsize=0.7, color="#0284C7", fontcolor="#0284C7"];
p [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#4F46E5"><FONT COLOR="white" POINT-SIZE="15"><B>Pre-Prepare</B></FONT></TD></TR><TR><TD BGCOLOR="#EEF2FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">主节点提出视图、序号与请求摘要</FONT></TD></TR></TABLE>>];
r [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#D97706"><FONT COLOR="white" POINT-SIZE="15"><B>Prepared</B></FONT></TD></TR><TR><TD BGCOLOR="#FFFBEB" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">请求 + PRE-PREPARE<BR ALIGN="LEFT"/>2f 条不同备份的匹配 PREPARE，可含自己</FONT></TD></TR></TABLE>>];
c [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#0D9488"><FONT COLOR="white" POINT-SIZE="15"><B>本地提交</B></FONT></TD></TR><TR><TD BGCOLOR="#F0FDFA" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">本地 prepared + 2f+1 条 COMMIT<BR ALIGN="LEFT"/>按序执行；客户端等 f+1 个一致回复</FONT></TD></TR></TABLE>>];
v [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#7C3AED"><FONT COLOR="white" POINT-SIZE="15"><B>视图切换</B></FONT></TD></TR><TR><TD BGCOLOR="#F5F3FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">收集 2f+1 份换主证据<BR ALIGN="LEFT"/>验证安全选值，保留已提交决定</FONT></TD></TR></TABLE>>];
p -> r;
r -> c;
r -> v [label="怀疑主节点"];
c -> v [label="换主仍需保留决定"];
}
