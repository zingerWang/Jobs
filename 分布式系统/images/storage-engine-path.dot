digraph G {
graph [rankdir=TB, bgcolor="white", dpi=200, pad=0.3, nodesep=0.3, ranksep=0.6, fontname="PingFang SC", labelloc=t, label=<<FONT POINT-SIZE="24" COLOR="#1E293B"><B>LSM：前台写入与后台合并</B></FONT><BR/><FONT POINT-SIZE="13" COLOR="#64748B">以启用 WAL 的典型路径说明；同步选项决定确认边界</FONT>>];
node [shape=plaintext, fontname="PingFang SC"];
edge [fontname="PingFang SC", fontsize=11, arrowhead=normal, arrowsize=0.7, color="#0284C7", fontcolor="#0284C7"];
w [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#4F46E5"><FONT COLOR="white" POINT-SIZE="15"><B>Put</B></FONT></TD></TR><TR><TD BGCOLOR="#EEF2FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">写入键与版本</FONT></TD></TR></TABLE>>];
l [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white" POINT-SIZE="15"><B>WAL 与内存表</B></FONT></TD></TR><TR><TD BGCOLOR="#F0F9FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">记录日志，更新有序内存状态<BR ALIGN="LEFT"/>要求掉电持久时同步必要日志</FONT></TD></TR></TABLE>>];
s [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#0D9488"><FONT COLOR="white" POINT-SIZE="15"><B>SST 文件</B></FONT></TD></TR><TR><TD BGCOLOR="#F0FDFA" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">内存表刷成有序文件<BR ALIGN="LEFT"/>读取时合并多个来源的可见版本</FONT></TD></TR></TABLE>>];
c [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#D97706"><FONT COLOR="white" POINT-SIZE="15"><B>后台合并</B></FONT></TD></TR><TR><TD BGCOLOR="#FFFBEB" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">合并文件、清理允许删除的旧版本<BR ALIGN="LEFT"/>占用 I/O；关注放大和写停顿</FONT></TD></TR></TABLE>>];
w -> l;
l -> s [label="刷表"];
s -> c [label="合并"];
}
