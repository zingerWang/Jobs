digraph mindmap_02 {
    rankdir=LR;
    graph [fontname="PingFang SC", bgcolor="white", pad=0.4, nodesep=0.35, ranksep=0.7, label=<<FONT POINT-SIZE="22" COLOR="#1E293B"><B>思维导图：分布式系统中的故障模型</B></FONT>>, labelloc=t, fontname="PingFang SC"];
    node [fontname="PingFang SC", shape=plaintext, margin=0];
    edge [fontname="PingFang SC", fontsize=11, penwidth=1.5, arrowsize=0.8, color="#94A3B8"];

    root [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#475569" COLOR="white" ALIGN="CENTER" CELLPADDING="9"><FONT POINT-SIZE="15"><B>故障模型<br/>与系统模型</B></FONT></TD></TR>
</TABLE>>];

    s1 [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#D97706" COLOR="white" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="12"><B>故障模型（怎么坏）</B></FONT></TD></TR>
</TABLE>>];
    s2 [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#0D9488" COLOR="white" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="12"><B>系统模型（时间规则）</B></FONT></TD></TR>
</TABLE>>];
    s3 [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#7C3AED" COLOR="white" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="12"><B>模型决定对错</B></FONT></TD></TR>
</TABLE>>];

    l1a [label=<<FONT POINT-SIZE="11" COLOR="#1E293B">崩溃-停止：崩了就静默，最友好</FONT>>];
    l1b [label=<<FONT POINT-SIZE="11" COLOR="#1E293B">崩溃-恢复：崩了重启但失忆 → 持久化</FONT>>];
    l1c [label=<<FONT POINT-SIZE="11" COLOR="#1E293B">遗漏：消息可能丢（与崩溃无法区分）</FONT>>];
    l1d [label=<<FONT POINT-SIZE="11" COLOR="#1E293B">网络分区：一群节点一起失联 → 脑裂</FONT>>];
    l1e [label=<<FONT POINT-SIZE="11" COLOR="#BE123C"><B>拜占庭：任意撒谎（最难，需防骗）</B></FONT>>];

    l2a [label=<<FONT POINT-SIZE="11" COLOR="#0F766E">同步：有上界 → 超时可靠</FONT>>];
    l2b [label=<<FONT POINT-SIZE="11" COLOR="#B45309"><B>部分同步：GST 后同步 → 最贴近现实</B></FONT>>];
    l2c [label=<<FONT POINT-SIZE="11" COLOR="#BE123C">异步：无上界 → 超时不可靠</FONT>>];

    l3a [label=<<FONT POINT-SIZE="11" COLOR="#1E293B">同步下「超时=失败」，重试安全</FONT>>];
    l3b [label=<<FONT POINT-SIZE="11" COLOR="#1E293B">异步下「超时≠失败」，重试可能重复</FONT>>];
    l3c [label=<<FONT POINT-SIZE="11" COLOR="#0F766E"><B>真实系统：崩溃 + 部分同步</B></FONT>>];

    root -> s1; root -> s2; root -> s3;
    s1 -> l1a; s1 -> l1b; s1 -> l1c; s1 -> l1d; s1 -> l1e;
    s2 -> l2a; s2 -> l2b; s2 -> l2c;
    s3 -> l3a; s3 -> l3b; s3 -> l3c;
}
