digraph lock_impl {
    rankdir=TB;
    graph [fontname="PingFang SC", bgcolor="white", pad=0.5, nodesep=0.7, ranksep=0.55, label=<<FONT POINT-SIZE="24" COLOR="#1E293B"><B>分布式锁的三种实现</B></FONT><BR/><FONT POINT-SIZE="13" COLOR="#64748B">同一个需求「同一时刻只有一个客户端能进临界区」，三种技术路线各有代价</FONT>>, labelloc=t, fontname="PingFang SC"];
    node [fontname="PingFang SC", shape=plaintext, margin=0];
    edge [fontname="PingFang SC", fontsize=12, penwidth=1.6, arrowsize=0.9, color="#94A3B8"];

    redis [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#E11D48" COLOR="white" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="13"><B>① Redis：SET NX + 过期时间</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#FFF1F2" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="11" COLOR="#BE123C"><B>SET lock_key my_id NX PX 30000</B><BR/>解锁要用 Lua 脚本校验 value 是自己的 id（防止误删别人的锁）<BR/>· 优点：<b>快</b>（一次内存操作）、实现简单、生态成熟（Redisson）<BR/>· 缺点：<b>单点问题</b>——主从切换时锁可能丢（异步复制：主刚加锁就宕机，从升主后没有这把锁）<BR/>· 衍生出 <b>Redlock</b>（向 N 个独立节点抢锁，过半即成功）来对抗单点——但它自己也有争议（见下一张图）</FONT></TD></TR>
</TABLE>>];

    zk [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#0D9488" COLOR="white" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="13"><B>② ZooKeeper：临时顺序节点</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#F0FDFA" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="11" COLOR="#0F766E">在 <B>/locks</B> 下创建<b>临时顺序节点</b>，序号最小者持锁；其他人只 watch 自己前一个<BR/>· 优点：<b>顺序天然公平</b>（先到先得）；无羊群效应；会话断则自动释放<BR/>· 缺点：<b>性能较低</b>（每次加解锁都是一次写 + 一次 watch 通知，走 Zab 共识）；依赖 ZK 集群<BR/>· 小心：<b>会话过期</b>会带来"假死丢锁"——你的进程还活着，但 ZK 认为你死了</FONT></TD></TR>
</TABLE>>];

    etcd [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#4F46E5" COLOR="white" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="13"><B>③ etcd：Lease + Revision（CAS）</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#EEF2FF" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="11" COLOR="#3730A3">用 <B>lease</B> 绑定一个 key，加锁 = 抢占式地创建（事务 CAS：不存在才写入）<BR/>· 优点：<b>自带 Global Revision</b>——这个单调递增的版本号天然就是 fencing token 的来源<BR/>· 解锁 / 续约靠 lease 的 keepalive；进程挂了 lease 到期自动释放<BR/>· 缺点：写要走 Raft 共识，比 Redis 慢；适合"锁竞争不激烈但要求正确"的场景</FONT></TD></TR>
</TABLE>>];

    cmp [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#7C3AED" COLOR="white" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="12"><B>怎么选</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#F5F3FF" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="11" COLOR="#6D28D9">· <B>只是防重复、能容忍极小概率失效</B>（定时任务不重复跑）→ Redis 够用，但要加 token 校验<BR/>· <B>要求公平 + 自动释放 + 强一致</B>（选主、分片调度）→ ZooKeeper / etcd<BR/>· <B>已经用了 etcd 做配置中心</B> → 顺手用 etcd 的 lease，少维护一个组件<BR/><FONT COLOR="#5B21B6">无论选哪个：<b>只要临界区里有"不可回滚"的副作用，就必须上 fencing token</b>。</FONT></FONT></TD></TR>
</TABLE>>];

    redis -> cmp [label=" 快但要防单点"];
    zk -> cmp [label=" 公平但慢"];
    etcd -> cmp [label=" 平衡且自带版本号"];
    { rank=same; redis; zk; etcd; }
}
