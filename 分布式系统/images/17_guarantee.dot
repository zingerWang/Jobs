digraph guarantee {
    rankdir=TB;
    graph [fontname="PingFang SC", bgcolor="white", pad=0.5, nodesep=0.7, ranksep=0.55, label=<<FONT POINT-SIZE="24" COLOR="#1E293B"><B>「恰好一次」的三层保证</B></FONT><BR/><FONT POINT-SIZE="13" COLOR="#64748B">任何一层单独都不够：投递只能做到至少一次，幂等只能防重复，对账才能兜住"想都没想到"的错</FONT>>, labelloc=t, fontname="PingFang SC"];
    node [fontname="PingFang SC", shape=plaintext, margin=0];
    edge [fontname="PingFang SC", fontsize=12, penwidth=1.6, arrowsize=0.9, color="#94A3B8"];

    l1 [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#4F46E5" COLOR="white" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="12"><B>第一层：可靠投递（至少一次）</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#EEF2FF" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="11" COLOR="#3730A3">· 本地消息表 / 事务消息：保证"业务成功 ⇒ 消息一定会被发出去"<BR/>· MQ 自身持久化 + 副本：保证"消息进了 MQ 就不会因为 broker 宕机而丢"<BR/>· 消费端 <B>手动 ACK</B>：处理完才确认，崩溃了消息会重投<BR/><FONT COLOR="#4338CA">这一层能做到的极限就是<b>至少一次</b>——重复是它的固有代价（见第 6 节示例）。</FONT></FONT></TD></TR>
</TABLE>>];

    l2 [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#0D9488" COLOR="white" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="12"><B>第二层：消费幂等（把重复吃掉）</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#F0FDFA" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="11" COLOR="#0F766E">· <B>去重表</B>：处理前先按 msg_id 插入去重表，插入失败说明处理过（<b>和业务在同一个本地事务里</b>）<BR/>· <B>业务唯一键</B>：订单号 + 状态机，"已支付"的订单不重复扣款（最可靠，无需额外表）<BR/>· <B>CAS / 乐观锁</B>：`UPDATE ... WHERE status = 'PENDING'`，影响行数为 0 就跳过<BR/><FONT COLOR="#115E59">注意：幂等键必须是<b>业务唯一标识</b>，不能用"消息到达时间"这类每次都变的东西。</FONT></FONT></TD></TR>
</TABLE>>];

    l3 [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#D97706" COLOR="white" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="12"><B>第三层：对账兜底（承认"总会有想不到的错"）</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#FFFBEB" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="11" COLOR="#B45309">· <B>定时对账</B>：每天/每小时比对上下游的状态（订单数 vs 库存流水），把长期不一致的揪出来<BR/>· <B>补偿任务</B>：对账发现的差异，自动重发/回滚/告警人工介入<BR/>· <B>消息堆积监控</B>：outbox 里 PENDING 堆积、MQ 消费 lag 上涨，都是事故的前兆<BR/><FONT COLOR="#92400E">为什么必须有这一层？因为代码逻辑再严密，也挡不住"两边规则理解不一致"这种<b>业务级</b>偏差。</FONT></FONT></TD></TR>
</TABLE>>];

    note [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#E11D48" COLOR="white" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="12"><B>「恰好一次」是效果，不是机制</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#FFF1F2" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="11" COLOR="#BE123C">分布式系统里<b>不存在"恰好投递一次"的机制</b>——只有：<BR/><B>至少一次投递 + 幂等消费 = 恰好一次的效果</B>。<BR/>把这句话贴在代码评审的检查表上：<b>只要有人写"发消息"，就必须有人回答"消费端怎么幂等"。</b></FONT></TD></TR>
</TABLE>>];

    l1 -> l2 [label=" 重复怎么办"];
    l2 -> l3 [label=" 漏网的怎么办"];
    l3 -> note [label=" 心法", color="#E11D48", fontcolor="#BE123C"];
}
