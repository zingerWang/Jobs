digraph mindmap_12 {
    rankdir=LR;
    graph [fontname="PingFang SC", bgcolor="white", pad=0.4, nodesep=0.35, ranksep=0.7, label=<<FONT POINT-SIZE="22" COLOR="#1E293B"><B>思维导图：领导者选举、心跳与租约</B></FONT>>, labelloc=t, fontname="PingFang SC"];
    node [fontname="PingFang SC", shape=plaintext, margin=0];
    edge [fontname="PingFang SC", fontsize=11, penwidth=1.5, arrowsize=0.8, color="#94A3B8"];

    root [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#475569" COLOR="white" ALIGN="CENTER" CELLPADDING="9"><FONT POINT-SIZE="15"><B>选举、心跳<br/>与租约</B></FONT></TD></TR>
</TABLE>>];

    s1 [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#4F46E5" COLOR="white" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="12"><B>三种范式</B></FONT></TD></TR>
</TABLE>>];
    s2 [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#D97706" COLOR="white" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="12"><B>心跳与超时</B></FONT></TD></TR>
</TABLE>>];
    s3 [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#E11D48" COLOR="white" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="12"><B>租约与假死</B></FONT></TD></TR>
</TABLE>>];
    s4 [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#0D9488" COLOR="white" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="12"><B>三重防线</B></FONT></TD></TR>
</TABLE>>];

    l1a [label=<<FONT POINT-SIZE="11" COLOR="#1E293B">共识内建：Raft / Zab，term + 选举限制</FONT>>];
    l1b [label=<<FONT POINT-SIZE="11" COLOR="#1E293B">外部协调：ZK / etcd 抢临时节点（把复杂度外包）</FONT>>];
    l1c [label=<<FONT POINT-SIZE="11" COLOR="#3730A3">租约：把「确认领导权」的成本降到零</FONT>>];

    l2a [label=<<FONT POINT-SIZE="11" COLOR="#1E293B">超时 ≠ 失败：故障检测器只能"怀疑"</FONT>>];
    l2b [label=<<FONT POINT-SIZE="11" COLOR="#1E293B">超时太短 → 选主癫痫；太长 → 恢复慢</FONT>>];
    l2c [label=<<FONT POINT-SIZE="11" COLOR="#B45309">经验：超时 &gt; 2~3× 心跳；跨机房按 RTT 放大</FONT>>];

    l3a [label=<<FONT POINT-SIZE="11" COLOR="#1E293B">租约只能"减少"假死窗口，无法消除</FONT>>];
    l3b [label=<<FONT POINT-SIZE="11" COLOR="#1E293B">挂起期间本地时钟也停 → 旧主不知道自己过期</FONT>>];
    l3c [label=<<FONT POINT-SIZE="11" COLOR="#BE123C"><B>双主伤害：旧主后写会覆盖新值</B></FONT>>];

    l4a [label=<<FONT POINT-SIZE="11" COLOR="#1E293B">① Fencing token：换主递增，下游拒绝旧 token</FONT>>];
    l4b [label=<<FONT POINT-SIZE="11" COLOR="#1E293B">② 保守取值：缩短租约、放宽超时</FONT>>];
    l4c [label=<<FONT POINT-SIZE="11" COLOR="#0F766E">③ 时钟监控 + 别给共识组件设过紧的 CPU limit</FONT>>];

    root -> s1; root -> s2; root -> s3; root -> s4;
    s1 -> l1a; s1 -> l1b; s1 -> l1c;
    s2 -> l2a; s2 -> l2b; s2 -> l2c;
    s3 -> l3a; s3 -> l3b; s3 -> l3c;
    s4 -> l4a; s4 -> l4b; s4 -> l4c;
}
