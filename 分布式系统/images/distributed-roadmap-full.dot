digraph G {
graph [rankdir=LR, bgcolor="white", dpi=200, pad=0.3, nodesep=0.22, ranksep=0.6, fontname="PingFang SC", labelloc=t, label=<<FONT POINT-SIZE="24" COLOR="#1E293B"><B>分布式系统：从原理到故障处理</B></FONT><BR/><FONT POINT-SIZE="13" COLOR="#64748B">学习提纲 · 先解释为什么，再理解机制与保证范围</FONT>>];
node [shape=plaintext, fontname="PingFang SC"];
edge [fontname="PingFang SC", fontsize=11, arrowsize=0.7, arrowhead=normal, penwidth=1.3];
root [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#4F46E5"><FONT COLOR="white" POINT-SIZE="15"><B>分布式系统学习路线</B></FONT></TD></TR><TR><TD BGCOLOR="#EEF2FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">从故障场景理解机制<BR ALIGN="LEFT"/>再讨论边界、代价与验证</FONT></TD></TR></TABLE>>];
g0 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#4F46E5"><FONT COLOR="white" POINT-SIZE="15"><B>01 · 基础概念与故障模型</B></FONT></TD></TR><TR><TD BGCOLOR="#EEF2FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">为什么多台机器更难协作</FONT></TD></TR></TABLE>>];
g0_0 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#4F46E5"><FONT COLOR="white" POINT-SIZE="15"><B>目标与代价</B></FONT></TD></TR><TR><TD BGCOLOR="#EEF2FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">多节点协作：扩展容量、性能和可用性<BR ALIGN="LEFT"/>代价：网络通信、数据协调和运维复杂度<BR ALIGN="LEFT"/>区分安全性：不出错；活性：能继续推进</FONT></TD></TR></TABLE>>];
g0_1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#4F46E5"><FONT COLOR="white" POINT-SIZE="15"><B>网络与节点故障</B></FONT></TD></TR><TR><TD BGCOLOR="#EEF2FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">延迟、丢失、重复、乱序与网络分区<BR ALIGN="LEFT"/>进程崩溃、重启、长时间暂停；部分节点失败<BR ALIGN="LEFT"/>故障模型：崩溃故障与拜占庭故障</FONT></TD></TR></TABLE>>];
g0_2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#4F46E5"><FONT COLOR="white" POINT-SIZE="15"><B>时间与理论边界</B></FONT></TD></TR><TR><TD BGCOLOR="#EEF2FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">物理时钟会偏移；逻辑时钟表达事件顺序<BR ALIGN="LEFT"/>Lamport 时钟、向量时钟；心跳超时只能怀疑故障<BR ALIGN="LEFT"/>FLP：完全异步等假设下确定性共识的终止限制</FONT></TD></TR></TABLE>>];
g1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#7C3AED"><FONT COLOR="white" POINT-SIZE="15"><B>02 · 一致性与 CAP</B></FONT></TD></TR><TR><TD BGCOLOR="#F5F3FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">写成功后，别人究竟能读到什么</FONT></TD></TR></TABLE>>];
g1_0 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#7C3AED"><FONT COLOR="white" POINT-SIZE="15"><B>一致性保证</B></FONT></TD></TR><TR><TD BGCOLOR="#F5F3FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">线性一致性：尊重操作的实时先后关系<BR ALIGN="LEFT"/>顺序一致性、因果一致性、最终一致性<BR ALIGN="LEFT"/>读己之写、单调读；用具体读写历史判断</FONT></TD></TR></TABLE>>];
g1_1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#7C3AED"><FONT COLOR="white" POINT-SIZE="15"><B>CAP 与工程取舍</B></FONT></TD></TR><TR><TD BGCOLOR="#F5F3FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">网络分区时：无法同时保证线性一致与 CAP 可用性<BR ALIGN="LEFT"/>CAP 可用性：非故障节点收到的请求最终得到响应<BR ALIGN="LEFT"/>BASE 是设计思路；最终一致仍需传播与冲突处理</FONT></TD></TR></TABLE>>];
g1_2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#7C3AED"><FONT COLOR="white" POINT-SIZE="15"><B>事务与一致性不能混用</B></FONT></TD></TR><TR><TD BGCOLOR="#F5F3FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">可串行化：事务结果等价于某个串行顺序<BR ALIGN="LEFT"/>严格可串行化：还尊重事务的实时先后<BR ALIGN="LEFT"/>隔离级别、快照隔离、写偏斜与并发控制</FONT></TD></TR></TABLE>>];
g2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white" POINT-SIZE="15"><B>03 · 副本、共识与 Raft</B></FONT></TD></TR><TR><TD BGCOLOR="#F0F9FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">主节点故障后，已经确认的数据怎么办</FONT></TD></TR></TABLE>>];
g2_0 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white" POINT-SIZE="15"><B>副本复制</B></FONT></TD></TR><TR><TD BGCOLOR="#F0F9FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">单主、多主、无主；同步与异步复制<BR ALIGN="LEFT"/>确认时机、复制延迟、故障切换与数据丢失窗口<BR ALIGN="LEFT"/>Quorum 交集需结合版本和协议，不能直接推出强一致</FONT></TD></TR></TABLE>>];
g2_1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white" POINT-SIZE="15"><B>共识的核心过程</B></FONT></TD></TR><TR><TD BGCOLOR="#F0F9FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">复制状态机：按相同顺序应用已提交操作<BR ALIGN="LEFT"/>Raft：任期、投票限制、日志复制与提交规则<BR ALIGN="LEFT"/>领导者／跟随者／候选者是 Raft 的角色</FONT></TD></TR></TABLE>>];
g2_2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white" POINT-SIZE="15"><B>算法与工程边界</B></FONT></TD></TR><TR><TD BGCOLOR="#F0F9FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">Paxos、Raft、Zab；拜占庭容错协议作为进阶<BR ALIGN="LEFT"/>线性一致读、旧主隔离、快照与落后副本追赶<BR ALIGN="LEFT"/>成员变更：不能随意切换多数派的计算范围</FONT></TD></TR></TABLE>>];
g3 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#E11D48"><FONT COLOR="white" POINT-SIZE="15"><B>04 · RPC、超时与重试</B></FONT></TD></TR><TR><TD BGCOLOR="#FFF1F2" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">没收到响应，不等于对方没有执行</FONT></TD></TR></TABLE>>];
g3_0 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#E11D48"><FONT COLOR="white" POINT-SIZE="15"><B>调用基础</B></FONT></TD></TR><TR><TD BGCOLOR="#FFF1F2" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">序列化、连接管理、请求编号与错误分类<BR ALIGN="LEFT"/>gRPC、brpc、Thrift：结合调用链学习<BR ALIGN="LEFT"/>总截止时间向下传递；取消不代表撤销已发生的效果</FONT></TD></TR></TABLE>>];
g3_1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#E11D48"><FONT COLOR="white" POINT-SIZE="15"><B>重试控制</B></FONT></TD></TR><TR><TD BGCOLOR="#FFF1F2" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">区分明确失败、成功与结果未知<BR ALIGN="LEFT"/>指数退避、随机抖动、次数限制与重试预算<BR ALIGN="LEFT"/>避免多层重试放大流量；区分可重试与不可重试错误</FONT></TD></TR></TABLE>>];
g3_2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#E11D48"><FONT COLOR="white" POINT-SIZE="15"><B>幂等实现</B></FONT></TD></TR><TR><TD BGCOLOR="#FFF1F2" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">业务幂等键、请求内容校验、结果保存与有效期<BR ALIGN="LEFT"/>唯一约束／条件更新处理相同请求并发到达<BR ALIGN="LEFT"/>去重记录与业务变更需协调，不能只查一次是否存在</FONT></TD></TR></TABLE>>];
g4 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#7C3AED"><FONT COLOR="white" POINT-SIZE="15"><B>05 · 分布式锁、租约与 ID</B></FONT></TD></TR><TR><TD BGCOLOR="#F5F3FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">锁到期后，旧持有者为什么还可能写数据</FONT></TD></TR></TABLE>>];
g4_0 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#7C3AED"><FONT COLOR="white" POINT-SIZE="15"><B>锁的实现与边界</B></FONT></TD></TR><TR><TD BGCOLOR="#F5F3FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">Redis：原子获取、持有者标识、条件释放与续期<BR ALIGN="LEFT"/>ZooKeeper 临时节点；etcd Lease 与事务<BR ALIGN="LEFT"/>Redlock 要分析故障假设，不能等同任意场景的安全锁</FONT></TD></TR></TABLE>>];
g4_1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#7C3AED"><FONT COLOR="white" POINT-SIZE="15"><B>旧持有者隔离</B></FONT></TD></TR><TR><TD BGCOLOR="#F5F3FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">长暂停 → 租约到期 → 新持有者开始工作<BR ALIGN="LEFT"/>Fencing token：递增凭证随操作发送<BR ALIGN="LEFT"/>实际资源校验凭证并拒绝旧操作；续期不能代替它</FONT></TD></TR></TABLE>>];
g4_2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#7C3AED"><FONT COLOR="white" POINT-SIZE="15"><B>分布式 ID 与替代方案</B></FONT></TD></TR><TR><TD BGCOLOR="#F5F3FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">Snowflake：时间、节点编号、序列及回拨处理<BR ALIGN="LEFT"/>号段：批量分配；UUID：唯一性与索引局部性<BR ALIGN="LEFT"/>互斥需求也可用唯一约束、版本号与条件更新解决</FONT></TD></TR></TABLE>>];
g5 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#7C3AED"><FONT COLOR="white" POINT-SIZE="15"><B>06 · 事务与跨服务业务一致性</B></FONT></TD></TR><TR><TD BGCOLOR="#F5F3FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">多个服务怎样一起完成一笔业务</FONT></TD></TR></TABLE>>];
g5_0 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#7C3AED"><FONT COLOR="white" POINT-SIZE="15"><B>原子提交</B></FONT></TD></TR><TR><TD BGCOLOR="#F5F3FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">2PC：准备、提交；恢复日志与协调者故障<BR ALIGN="LEFT"/>XA 是事务接口规范，常与两阶段提交配合<BR ALIGN="LEFT"/>3PC 有时延与故障假设，不能保证任意分区下无阻塞</FONT></TD></TR></TABLE>>];
g5_1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#7C3AED"><FONT COLOR="white" POINT-SIZE="15"><B>业务补偿</B></FONT></TD></TR><TR><TD BGCOLOR="#F5F3FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">TCC：预留、确认、取消；空回滚、悬挂与幂等<BR ALIGN="LEFT"/>Saga：本地事务串联；编排或事件协作<BR ALIGN="LEFT"/>补偿是新业务操作，可能失败，也不一定恢复原样</FONT></TD></TR></TABLE>>];
g5_2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#7C3AED"><FONT COLOR="white" POINT-SIZE="15"><B>落地与恢复</B></FONT></TD></TR><TR><TD BGCOLOR="#F5F3FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">Seata：AT／TCC／Saga／XA，理解模式边界<BR ALIGN="LEFT"/>业务状态机、超时恢复、重试、对账与人工介入<BR ALIGN="LEFT"/>区分提交原子性、隔离性和业务最终一致性</FONT></TD></TR></TABLE>>];
g6 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white" POINT-SIZE="15"><B>07 · 消息队列与可靠事件</B></FONT></TD></TR><TR><TD BGCOLOR="#F0F9FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">数据库已提交，消息却没发出去怎么办</FONT></TD></TR></TABLE>>];
g6_0 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white" POINT-SIZE="15"><B>消息传递机制</B></FONT></TD></TR><TR><TD BGCOLOR="#F0F9FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">解耦、异步、削峰；Kafka／RocketMQ／RabbitMQ<BR ALIGN="LEFT"/>生产确认、持久化、副本、消费确认与位点<BR ALIGN="LEFT"/>分区内顺序、消费组、重平衡与重复投递</FONT></TD></TR></TABLE>>];
g6_1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white" POINT-SIZE="15"><B>数据库与消息衔接</B></FONT></TD></TR><TR><TD BGCOLOR="#F0F9FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">Outbox：业务记录与待发事件写入同一本地事务<BR ALIGN="LEFT"/>轮询或 CDC 转发，转发仍可能重复<BR ALIGN="LEFT"/>消费去重记录与业务修改同事务；事务消息需明确协议</FONT></TD></TR></TABLE>>];
g6_2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white" POINT-SIZE="15"><B>语义与积压治理</B></FONT></TD></TR><TR><TD BGCOLOR="#F0F9FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">至多一次、至少一次、恰好一次：说明保证范围<BR ALIGN="LEFT"/>外部数据库的副作用不会自动获得恰好一次保证<BR ALIGN="LEFT"/>背压、积压监控、重试队列、死信与安全重放</FONT></TD></TR></TABLE>>];
g7 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white" POINT-SIZE="15"><B>08 · 存储、分片与缓存</B></FONT></TD></TR><TR><TD BGCOLOR="#F0F9FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">数据越来越多，怎样扩容又不读错</FONT></TD></TR></TABLE>>];
g7_0 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white" POINT-SIZE="15"><B>分片与迁移</B></FONT></TD></TR><TR><TD BGCOLOR="#F0F9FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">哈希、范围、一致性哈希与虚拟节点<BR ALIGN="LEFT"/>热点 Key／热点分片、路由、扩缩容与数据迁移<BR ALIGN="LEFT"/>跨分片查询与事务的代价；多主冲突需检测和解决</FONT></TD></TR></TABLE>>];
g7_1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white" POINT-SIZE="15"><B>缓存与数据库一致性</B></FONT></TD></TR><TR><TD BGCOLOR="#F0F9FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">Cache-Aside、Read/Write-Through、Write-Behind<BR ALIGN="LEFT"/>更新与失效的并发竞态；TTL 不是严格一致性协议<BR ALIGN="LEFT"/>穿透：空值／布隆；击穿：合并重建；雪崩：错峰与隔离</FONT></TD></TR></TABLE>>];
g7_2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white" POINT-SIZE="15"><B>存储类型与选型</B></FONT></TD></TR><TR><TD BGCOLOR="#F0F9FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">文件系统：HDFS；对象存储：MinIO<BR ALIGN="LEFT"/>KV：etcd、Redis Cluster；数据库：TiDB、CockroachDB<BR ALIGN="LEFT"/>按数据模型、持久化、一致性、查询与运维成本比较</FONT></TD></TR></TABLE>>];
g8 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#4F46E5"><FONT COLOR="white" POINT-SIZE="15"><B>09 · 服务发现、配置与网关</B></FONT></TD></TR><TR><TD BGCOLOR="#EEF2FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">请求怎样找到健康的服务实例</FONT></TD></TR></TABLE>>];
g8_0 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#4F46E5"><FONT COLOR="white" POINT-SIZE="15"><B>发现与配置</B></FONT></TD></TR><TR><TD BGCOLOR="#EEF2FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">注册、心跳、健康检查、摘除与客户端缓存<BR ALIGN="LEFT"/>Nacos／Eureka／Consul／etcd；理解组件职责差异<BR ALIGN="LEFT"/>配置版本、监听、灰度、回滚；Apollo 等配置系统</FONT></TD></TR></TABLE>>];
g8_1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#4F46E5"><FONT COLOR="white" POINT-SIZE="15"><B>路由与负载均衡</B></FONT></TD></TR><TR><TD BGCOLOR="#EEF2FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">四层／七层；轮询、权重、最少连接、一致性哈希<BR ALIGN="LEFT"/>Nginx、HAProxy、LVS；DNS 缓存影响切换速度<BR ALIGN="LEFT"/>网关负责路由、认证、限流；Kong／APISIX 等</FONT></TD></TR></TABLE>>];
g8_2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#4F46E5"><FONT COLOR="white" POINT-SIZE="15"><B>框架与任务调度</B></FONT></TD></TR><TR><TD BGCOLOR="#EEF2FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">Spring Cloud、Dubbo：学习调用与治理机制<BR ALIGN="LEFT"/>分布式调度：分片、重复执行、失败恢复<BR ALIGN="LEFT"/>XXL-JOB／Elastic-Job：任务同样需要幂等与隔离</FONT></TD></TR></TABLE>>];
g9 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#D97706"><FONT COLOR="white" POINT-SIZE="15"><B>10 · 流量、容量与过载保护</B></FONT></TD></TR><TR><TD BGCOLOR="#FFFBEB" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">请求比处理能力多时，怎样避免一起崩溃</FONT></TD></TR></TABLE>>];
g9_0 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#D97706"><FONT COLOR="white" POINT-SIZE="15"><B>限制进入与等待</B></FONT></TD></TR><TR><TD BGCOLOR="#FFFBEB" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">令牌桶、漏桶、固定／滑动窗口<BR ALIGN="LEFT"/>并发限制、有界队列、连接池与线程池隔离<BR ALIGN="LEFT"/>背压：让上游减速；排队容量不能解决长期过载</FONT></TD></TR></TABLE>>];
g9_1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#D97706"><FONT COLOR="white" POINT-SIZE="15"><B>故障隔离与降级</B></FONT></TD></TR><TR><TD BGCOLOR="#FFFBEB" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">熔断、半开探测、舱壁隔离与兜底策略<BR ALIGN="LEFT"/>降级明确允许的功能损失和数据陈旧程度<BR ALIGN="LEFT"/>区分限流、熔断、超时和重试各自解决的问题</FONT></TD></TR></TABLE>>];
g9_2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#D97706"><FONT COLOR="white" POINT-SIZE="15"><B>容量与性能判断</B></FONT></TD></TR><TR><TD BGCOLOR="#FFFBEB" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">吞吐、平均延迟、P95／P99 尾延迟与资源饱和<BR ALIGN="LEFT"/>并发量约等于吞吐乘平均耗时，需满足稳态等条件<BR ALIGN="LEFT"/>压测热点、突发和依赖故障；弹性扩容有生效延迟</FONT></TD></TR></TABLE>>];
g10 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0D9488"><FONT COLOR="white" POINT-SIZE="15"><B>11 · 可观测性与故障验证</B></FONT></TD></TR><TR><TD BGCOLOR="#F0FDFA" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">怎样发现、定位并复现一次故障</FONT></TD></TR></TABLE>>];
g10_0 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0D9488"><FONT COLOR="white" POINT-SIZE="15"><B>观测数据</B></FONT></TD></TR><TR><TD BGCOLOR="#F0FDFA" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">Metrics 指标、Logs 日志、Traces 调用链<BR ALIGN="LEFT"/>Prometheus、ELK／EFK；OpenTelemetry 等采集体系<BR ALIGN="LEFT"/>关联请求 ID；关注采样、标签基数和存储成本</FONT></TD></TR></TABLE>>];
g10_1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0D9488"><FONT COLOR="white" POINT-SIZE="15"><B>目标与告警</B></FONT></TD></TR><TR><TD BGCOLOR="#F0FDFA" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">SLI：实际指标；SLO：目标；错误预算：允许偏差<BR ALIGN="LEFT"/>围绕用户成功率、延迟、积压和复制滞后告警<BR ALIGN="LEFT"/>排错路径：入口 → 依赖 → 资源 → 数据状态</FONT></TD></TR></TABLE>>];
g10_2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0D9488"><FONT COLOR="white" POINT-SIZE="15"><B>验证系统承诺</B></FONT></TD></TR><TR><TD BGCOLOR="#F0FDFA" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">故障注入：分区、进程暂停、节点重启与慢设备<BR ALIGN="LEFT"/>Jepsen 等历史检查；压测与恢复演练分开记录<BR ALIGN="LEFT"/>混沌工程限制影响范围、设置停止条件与回滚路径</FONT></TD></TR></TABLE>>];
g11 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0D9488"><FONT COLOR="white" POINT-SIZE="15"><B>12 · 安全、发布与灾难恢复</B></FONT></TD></TR><TR><TD BGCOLOR="#F0FDFA" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">有副本之后，为什么仍要做备份</FONT></TD></TR></TABLE>>];
g11_0 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0D9488"><FONT COLOR="white" POINT-SIZE="15"><B>身份与通信安全</B></FONT></TD></TR><TR><TD BGCOLOR="#F0FDFA" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">OAuth 2.0 授权；OIDC 身份认证；JWT 是令牌格式<BR ALIGN="LEFT"/>SSO、权限最小化、mTLS、证书和密钥轮换<BR ALIGN="LEFT"/>零信任需身份与策略校验，不能只理解成加密</FONT></TD></TR></TABLE>>];
g11_1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0D9488"><FONT COLOR="white" POINT-SIZE="15"><B>发布与兼容</B></FONT></TD></TR><TR><TD BGCOLOR="#F0FDFA" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">滚动、灰度、蓝绿发布；摘流量与优雅停机<BR ALIGN="LEFT"/>协议／消息结构兼容，数据库模式渐进迁移<BR ALIGN="LEFT"/>回滚代码前确认新数据能否被旧版本理解</FONT></TD></TR></TABLE>>];
g11_2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0D9488"><FONT COLOR="white" POINT-SIZE="15"><B>容灾与恢复</B></FONT></TD></TR><TR><TD BGCOLOR="#F0FDFA" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">副本也会复制误删除；备份需独立保存并验证可恢复<BR ALIGN="LEFT"/>RPO：可容忍的数据损失；RTO：恢复时间目标<BR ALIGN="LEFT"/>跨可用区／机房切换、防脑裂、恢复演练和业务对账</FONT></TD></TR></TABLE>>];
g12 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#475569"><FONT COLOR="white" POINT-SIZE="15"><B>13 · 面试与综合练习</B></FONT></TD></TR><TR><TD BGCOLOR="#F8FAFC" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">用完整故障过程检验是否真正理解</FONT></TD></TR></TABLE>>];
g12_0 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#475569"><FONT COLOR="white" POINT-SIZE="15"><B>围绕一笔订单追问</B></FONT></TD></TR><TR><TD BGCOLOR="#F8FAFC" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">支付超时后能否重试？怎样防重复扣款？<BR ALIGN="LEFT"/>订单提交后消息丢失怎么办？消费成功却没 ACK 呢？<BR ALIGN="LEFT"/>库存扣减成功但后续失败，补偿失败又怎么办？</FONT></TD></TR></TABLE>>];
g12_1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#475569"><FONT COLOR="white" POINT-SIZE="15"><B>围绕一次故障追问</B></FONT></TD></TR><TR><TD BGCOLOR="#F8FAFC" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">主节点失联，怎样选主并保住已提交日志？<BR ALIGN="LEFT"/>锁持有者暂停后恢复，如何拒绝它的旧写入？<BR ALIGN="LEFT"/>从库读旧数据、缓存回填旧值、消费积压怎样定位？</FONT></TD></TR></TABLE>>];
g12_2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#475569"><FONT COLOR="white" POINT-SIZE="15"><B>动手验证</B></FONT></TD></TR><TR><TD BGCOLOR="#F8FAFC" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">实现幂等接口、Outbox、可重试消费者<BR ALIGN="LEFT"/>观察 Raft 选主与日志追赶；模拟租约过期<BR ALIGN="LEFT"/>记录故障前后状态、预期保证与实际结果</FONT></TD></TR></TABLE>>];
