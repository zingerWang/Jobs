digraph G {
graph [rankdir=LR, ordering=out, bgcolor="white", dpi=200, pad=0.3, nodesep=0.3, ranksep=0.6, fontname="PingFang SC", labelloc=t, label=<<FONT POINT-SIZE="24" COLOR="#1E293B"><B>基础概念与故障模型</B></FONT><BR/><FONT POINT-SIZE="13" COLOR="#64748B">从故障现象到持久化、接管保护与时间顺序</FONT>>];
node [shape=plaintext, fontname="PingFang SC"];
edge [fontname="PingFang SC", fontsize=11, arrowhead=normal, arrowsize=0.7, color="#0284C7", fontcolor="#0284C7"];
root [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#4F46E5"><FONT COLOR="white" POINT-SIZE="15"><B>基础概念与故障模型</B></FONT></TD></TR><TR><TD BGCOLOR="#EEF2FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">问题 → 机制 → 失败边界 → 验证</FONT></TD></TR></TABLE>>];
n0 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white" POINT-SIZE="15"><B>故障与超时</B></FONT></TD></TR><TR><TD BGCOLOR="#F0F9FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">部分失败；响应丢失不代表未执行<BR ALIGN="LEFT"/>崩溃停止、恢复、遗漏与分区分开描述<BR ALIGN="LEFT"/>write 不等于持久化；日志同步与恢复边界</FONT></TD></TR></TABLE>>];
n1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white" POINT-SIZE="15"><B>时间与顺序</B></FONT></TD></TR><TR><TD BGCOLOR="#F0F9FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">物理时钟有误差；单调时钟测时长<BR ALIGN="LEFT"/>Lamport 保留因果方向；向量时钟识别并发<BR ALIGN="LEFT"/>LWW 时间戳大小不等于真实先后<BR ALIGN="LEFT"/>TrueTime 误差区间、提交等待与事务协议</FONT></TD></TR></TABLE>>];
n2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white" POINT-SIZE="15"><B>理论边界</B></FONT></TD></TR><TR><TD BGCOLOR="#F0F9FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">安全性不出错；活性最终推进<BR ALIGN="LEFT"/>FLP 的异步假设；BFT 的故障假设</FONT></TD></TR></TABLE>>];
n3 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white" POINT-SIZE="15"><B>实验与验证</B></FONT></TD></TR><TR><TD BGCOLOR="#F0F9FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">相同超时对应不同真实结果<BR ALIGN="LEFT"/>双线程：乱序、响应丢失与重试去重<BR ALIGN="LEFT"/>观察模拟边界，不把仿真当协议证明</FONT></TD></TR></TABLE>>];
n4 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#D97706"><FONT COLOR="white" POINT-SIZE="15"><B>接管与写入保护</B></FONT></TD></TR><TR><TD BGCOLOR="#FFFBEB" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">租约过期不会停止旧进程<BR ALIGN="LEFT"/>资源端原子校验递增编号，拒绝旧持有者</FONT></TD></TR></TABLE>>];
root -> n0;
root -> n4 [color="#D97706"];
root -> n1;
root -> n2;
root -> n3;
engineering [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#D97706"><FONT COLOR="white" POINT-SIZE="15"><B>暂停与时间边界</B></FONT></TD></TR><TR><TD BGCOLOR="#FFFBEB" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">运行时暂停后恢复，仍需隔离旧持有者<BR ALIGN="LEFT"/>墙上时间可跳变；单调计时明确挂起语义</FONT></TD></TR></TABLE>>];
root -> engineering [color="#D97706",fontcolor="#D97706"];
}
