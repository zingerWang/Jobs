digraph hdfs_arch {
    rankdir=TB;
    compound=true;
    graph [fontname="PingFang SC", bgcolor="white", pad=0.5, nodesep=0.7, ranksep=0.5, label=<<FONT POINT-SIZE="24" COLOR="#1E293B"><B>HDFS 主从架构</B></FONT><BR/><FONT POINT-SIZE="13" COLOR="#64748B">NameNode 管元数据（大脑），DataNode 存数据块（干活的）</FONT>>, labelloc=t, fontname="PingFang SC"];
    node [fontname="PingFang SC", shape=plaintext, margin=0];
    edge [fontname="PingFang SC", fontsize=12, penwidth=1.6, arrowsize=0.9];

    client [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#4F46E5" COLOR="white" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="13"><B>客户端</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#EEF2FF" ALIGN="CENTER" CELLPADDING="5"><FONT POINT-SIZE="11" COLOR="#3730A3">读写文件</FONT></TD></TR>
</TABLE>>];

    namenode [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#E11D48" COLOR="white" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="13"><B>NameNode</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#FFF1F2" ALIGN="CENTER" CELLPADDING="5"><FONT POINT-SIZE="11" COLOR="#BE123C">元数据：文件在哪、切成哪些块<BR/>（不存数据本身）</FONT></TD></TR>
</TABLE>>];

    dn1 [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#0D9488" COLOR="white" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="13"><B>DataNode 1</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#F0FDFA" ALIGN="CENTER" CELLPADDING="5"><FONT POINT-SIZE="11" COLOR="#0F766E">块 1、块 2…</FONT></TD></TR>
</TABLE>>];
    dn2 [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#0D9488" COLOR="white" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="13"><B>DataNode 2</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#F0FDFA" ALIGN="CENTER" CELLPADDING="5"><FONT POINT-SIZE="11" COLOR="#0F766E">块 1、块 2…</FONT></TD></TR>
</TABLE>>];
    dn3 [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#0D9488" COLOR="white" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="13"><B>DataNode 3</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#F0FDFA" ALIGN="CENTER" CELLPADDING="5"><FONT POINT-SIZE="11" COLOR="#0F766E">块 1、块 2…</FONT></TD></TR>
</TABLE>>];

    { rank=same; dn1; dn2; dn3; }

    client -> namenode [label="① 元数据操作\n（文件在哪）", color="#E11D48", fontcolor="#BE123C"];
    client -> dn1 [label="② 读写数据块", color="#0D9488", fontcolor="#0F766E", constraint=false];
    dn1 -> namenode [label="心跳 + 块报告", color="#475569", fontcolor="#334155", style=dashed, constraint=false];
    dn2 -> namenode [label="心跳 + 块报告", color="#475569", fontcolor="#334155", style=dashed, constraint=false];
    dn3 -> namenode [label="心跳 + 块报告", color="#475569", fontcolor="#334155", style=dashed, constraint=false];

    dn1 -> dn2 [style=invis];
    dn2 -> dn3 [style=invis];
}
