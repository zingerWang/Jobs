digraph G {
graph [rankdir=LR, bgcolor="white", dpi=200, pad=0.3, nodesep=0.22, ranksep=0.6, fontname="PingFang SC", labelloc=t, label=<<FONT POINT-SIZE="24" COLOR="#1E293B"><B>soft 是当前上限，hard 是调节边界</B></FONT><BR/><FONT POINT-SIZE="13" COLOR="#64748B">示例：RLIMIT_NOFILE；降低额度不会自动关闭已经打开的 fd</FONT>>];
node [shape=plaintext, fontname="PingFang SC"];
edge [fontname="PingFang SC", fontsize=11, arrowsize=0.7, arrowhead=normal, penwidth=1.3];
a [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#4F46E5"><FONT COLOR="white" POINT-SIZE="15"><B>初始限制</B></FONT></TD></TR><TR><TD BGCOLOR="#EEF2FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">soft = 1024<BR ALIGN="LEFT"/>hard = 4096</FONT></TD></TR></TABLE>>];
b [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#D97706"><FONT COLOR="white" POINT-SIZE="15"><B>申请新 fd</B></FONT></TD></TR><TR><TD BGCOLOR="#FFFBEB" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">新 fd 编号须小于 soft<BR ALIGN="LEFT"/>没有可用编号时可报 EMFILE</FONT></TD></TR></TABLE>>];
c [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0D9488"><FONT COLOR="white" POINT-SIZE="15"><B>调整 soft = 2048</B></FONT></TD></TR><TR><TD BGCOLOR="#F0FDFA" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">没有超过 hard<BR ALIGN="LEFT"/>普通进程通常允许</FONT></TD></TR></TABLE>>];
d [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#E11D48"><FONT COLOR="white" POINT-SIZE="15"><B>调整 soft = 8192</B></FONT></TD></TR><TR><TD BGCOLOR="#FFF1F2" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">超过 hard = 4096<BR ALIGN="LEFT"/>不能这样直接设置成功</FONT></TD></TR></TABLE>>];
e [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#E11D48"><FONT COLOR="white" POINT-SIZE="15"><B>降低 hard 的后果</B></FONT></TD></TR><TR><TD BGCOLOR="#FFF1F2" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">普通进程通常不能再自行提高<BR ALIGN="LEFT"/>实验保持 hard 不变</FONT></TD></TR></TABLE>>];
a -> b [label="当前执行约束", color="#D97706", fontcolor="#D97706"];
a -> c [label="提高软限制", color="#0D9488", fontcolor="#0D9488"];
a -> d [label="非法软硬组合", color="#E11D48", fontcolor="#E11D48"];
a -> e [label="不可当作随意可逆", color="#E11D48", fontcolor="#E11D48"];

}
