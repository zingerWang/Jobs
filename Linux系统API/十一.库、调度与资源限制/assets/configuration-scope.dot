digraph G {
graph [rankdir=LR, bgcolor="white", dpi=200, pad=0.3, nodesep=0.22, ranksep=0.6, fontname="PingFang SC", labelloc=t, label=<<FONT POINT-SIZE="24" COLOR="#1E293B"><B>配置查询：先明确问题属于谁</B></FONT><BR/><FONT POINT-SIZE="13" COLOR="#64748B">查询限制不等于预留资源，实际申请仍可能失败</FONT>>];
node [shape=plaintext, fontname="PingFang SC"];
edge [fontname="PingFang SC", fontsize=11, arrowsize=0.7, arrowhead=normal, penwidth=1.3];
a [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#4F46E5"><FONT COLOR="white" POINT-SIZE="15"><B>应用准备申请资源</B></FONT></TD></TR><TR><TD BGCOLOR="#EEF2FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">线程池、映射、打开文件</FONT></TD></TR></TABLE>>];
b [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white" POINT-SIZE="15"><B>sysconf</B></FONT></TD></TR><TR><TD BGCOLOR="#F0F9FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">运行环境：页大小、在线逻辑 CPU<BR ALIGN="LEFT"/>打开文件限制等配置</FONT></TD></TR></TABLE>>];
c [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#7C3AED"><FONT COLOR="white" POINT-SIZE="15"><B>pathconf / fpathconf</B></FONT></TD></TR><TR><TD BGCOLOR="#F5F3FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">路径或已打开对象<BR ALIGN="LEFT"/>例如目录中文件名长度限制</FONT></TD></TR></TABLE>>];
d [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#D97706"><FONT COLOR="white" POINT-SIZE="15"><B>getrlimit</B></FONT></TD></TR><TR><TD BGCOLOR="#FFFBEB" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">当前进程的软硬限制<BR ALIGN="LEFT"/>可用 setrlimit 在权限内调整</FONT></TD></TR></TABLE>>];
e [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0D9488"><FONT COLOR="white" POINT-SIZE="15"><B>实际执行申请</B></FONT></TD></TR><TR><TD BGCOLOR="#F0FDFA" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">mmap / open / 创建线程<BR ALIGN="LEFT"/>仍需处理资源不足和其他错误</FONT></TD></TR></TABLE>>];
a -> b [label="系统配置", color="#0284C7", fontcolor="#0284C7"];
a -> c [label="对象限制", color="#7C3AED", fontcolor="#7C3AED"];
a -> d [label="进程额度", color="#D97706", fontcolor="#D97706"];
b -> e [label="", color="#0284C7", fontcolor="#0284C7"];
c -> e [label="", color="#7C3AED", fontcolor="#7C3AED"];
d -> e [label="", color="#D97706", fontcolor="#D97706"];

}
