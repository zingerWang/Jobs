digraph G {
graph [rankdir=LR, bgcolor="white", dpi=200, pad=0.3, nodesep=0.22, ranksep=0.6, fontname="PingFang SC", labelloc=t, label=<<FONT POINT-SIZE="24" COLOR="#1E293B"><B>库、调度与资源限制：知识关系图</B></FONT><BR/><FONT POINT-SIZE="13" COLOR="#64748B">先区分作用层次，再查询、调用并检查结果</FONT>>];
node [shape=plaintext, fontname="PingFang SC"];
edge [fontname="PingFang SC", fontsize=11, arrowsize=0.7, arrowhead=normal, penwidth=1.3];
root [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#4F46E5"><FONT COLOR="white" POINT-SIZE="15"><B>Linux 库、调度与资源限制</B></FONT></TD></TR><TR><TD BGCOLOR="#EEF2FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">代码从哪来、CPU 如何分配<BR ALIGN="LEFT"/>运行环境允许使用多少资源</FONT></TD></TR></TABLE>>];
n0 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white" POINT-SIZE="15"><B>一、库与链接</B></FONT></TD></TR><TR><TD BGCOLOR="#F0F9FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">.a：选取成员并入程序<BR ALIGN="LEFT"/>.so：记录依赖，运行时映射</FONT></TD></TR></TABLE>>];
n1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#7C3AED"><FONT COLOR="white" POINT-SIZE="15"><B>二、动态加载</B></FONT></TD></TR><TR><TD BGCOLOR="#F5F3FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">dlopen / dlsym / dlerror / dlclose<BR ALIGN="LEFT"/>错误、ABI、生命周期及 -ldl 版本边界</FONT></TD></TR></TABLE>>];
n2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#D97706"><FONT COLOR="white" POINT-SIZE="15"><B>三、调度</B></FONT></TD></TR><TR><TD BGCOLOR="#FFFBEB" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">nice 是相对权重，不是固定配额<BR ALIGN="LEFT"/>区分调度策略、亲和性与 CPU 预算</FONT></TD></TR></TABLE>>];
n3 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white" POINT-SIZE="15"><B>四、配置查询</B></FONT></TD></TR><TR><TD BGCOLOR="#F0F9FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">sysconf：fd 限制、逻辑 CPU、页大小<BR ALIGN="LEFT"/>pathconf：路径限制；-1 结合 errno</FONT></TD></TR></TABLE>>];
n4 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#E11D48"><FONT COLOR="white" POINT-SIZE="15"><B>五、资源限制</B></FONT></TD></TR><TR><TD BGCOLOR="#FFF1F2" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">soft 当前执行；hard 限制调节范围<BR ALIGN="LEFT"/>进程内线程共享，子进程继承</FONT></TD></TR></TABLE>>];
n5 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0D9488"><FONT COLOR="white" POINT-SIZE="15"><B>六、排查与验证</B></FONT></TD></TR><TR><TD BGCOLOR="#F0FDFA" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">链接路径、目标进程、权限与继承<BR ALIGN="LEFT"/>成功与失败分支；预期与实测分开</FONT></TD></TR></TABLE>>];
n6 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#475569"><FONT COLOR="white" POINT-SIZE="15"><B>七、面试与 Q&amp;A</B></FONT></TD></TR><TR><TD BGCOLOR="#F8FAFC" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">问题 → 机制 → 边界<BR ALIGN="LEFT"/>用缺库、旧指针和资源耗尽检验理解</FONT></TD></TR></TABLE>>];
root -> n0 [label="", color="#0284C7", fontcolor="#0284C7"];
root -> n1 [label="", color="#7C3AED", fontcolor="#7C3AED"];
root -> n2 [label="", color="#D97706", fontcolor="#D97706"];
root -> n3 [label="", color="#0284C7", fontcolor="#0284C7"];
root -> n4 [label="", color="#E11D48", fontcolor="#E11D48"];
root -> n5 [label="", color="#0D9488", fontcolor="#0D9488"];
