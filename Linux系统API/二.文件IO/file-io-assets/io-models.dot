digraph G {
graph [rankdir=LR, bgcolor="white", dpi=200, pad=0.3, nodesep=0.22, ranksep=0.6, fontname="PingFang SC", labelloc=t, label=<<FONT POINT-SIZE="24" COLOR="#1E293B"><B>就绪通知与完成通知</B></FONT><BR/><FONT POINT-SIZE="13" COLOR="#64748B">epoll 后仍需执行 I/O；io_uring 的 CQE 给出已提交请求的结果</FONT>>];
node [shape=plaintext, fontname="PingFang SC"];
edge [fontname="PingFang SC", fontsize=11, arrowsize=0.7, arrowhead=normal, penwidth=1.3];
ready [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#4F46E5"><FONT COLOR="white" POINT-SIZE="15"><B>等待就绪</B></FONT></TD></TR><TR><TD BGCOLOR="#EEF2FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">非阻塞 fd + epoll<BR ALIGN="LEFT"/>应用保存连接和传输进度</FONT></TD></TR></TABLE>>];
event [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#D97706"><FONT COLOR="white" POINT-SIZE="15"><B>就绪事件</B></FONT></TD></TR><TR><TD BGCOLOR="#FFFBEB" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">现在可以尝试读写<BR ALIGN="LEFT"/>不是完整消息或完成承诺</FONT></TD></TR></TABLE>>];
rw [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white" POINT-SIZE="15"><B>应用执行 read / write</B></FONT></TD></TR><TR><TD BGCOLOR="#F0F9FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">正数：推进进度<BR ALIGN="LEFT"/>EAGAIN：回去等；0：判断 EOF</FONT></TD></TR></TABLE>>];
sq [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#4F46E5"><FONT COLOR="white" POINT-SIZE="15"><B>提交请求 SQE</B></FONT></TD></TR><TR><TD BGCOLOR="#EEF2FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">读哪个文件、哪个位置、多少字节<BR ALIGN="LEFT"/>指定缓冲区并给请求编号</FONT></TD></TR></TABLE>>];
kernel [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#7C3AED"><FONT COLOR="white" POINT-SIZE="15"><B>内核执行请求</B></FONT></TD></TR><TR><TD BGCOLOR="#F5F3FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">设备路径或工作线程等<BR ALIGN="LEFT"/>不保证按提交顺序完成</FONT></TD></TR></TABLE>>];
cq [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0D9488"><FONT COLOR="white" POINT-SIZE="15"><B>读取完成结果 CQE</B></FONT></TD></TR><TR><TD BGCOLOR="#F0FDFA" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">哪个请求完成，读写多少字节或为何失败<BR ALIGN="LEFT"/>请求完成后才能释放缓冲区</FONT></TD></TR></TABLE>>];
ready -> event [label="", color="#0284C7", fontcolor="#0284C7"];
event -> rw [label="", color="#0284C7", fontcolor="#0284C7"];
sq -> kernel [label="", color="#7C3AED", fontcolor="#7C3AED"];
kernel -> cq [label="", color="#0D9488", fontcolor="#0D9488"];
{rank=same; ready; sq;} {rank=same; event; kernel;} {rank=same; rw; cq;}
}
