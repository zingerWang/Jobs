digraph G {
graph [rankdir=LR, bgcolor="white", dpi=200, pad=0.3, nodesep=0.22, ranksep=0.6, fontname="PingFang SC", labelloc=t, label=<<FONT POINT-SIZE="24" COLOR="#1E293B"><B>直接 I/O：三个数分别检查对齐</B></FONT><BR/><FONT POINT-SIZE="13" COLOR="#64748B">假设要求：内存地址按 4096 对齐；文件偏移和长度按 512 对齐；以实际查询为准</FONT>>];
node [shape=plaintext, fontname="PingFang SC"];
edge [fontname="PingFang SC", fontsize=11, arrowsize=0.7, arrowhead=normal, penwidth=1.3];
a [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#4F46E5"><FONT COLOR="white" POINT-SIZE="15"><B>缓冲区地址</B></FONT></TD></TR><TR><TD BGCOLOR="#EEF2FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">address % 4096 == 0<BR ALIGN="LEFT"/>即使长度正确，地址 + 1 也不满足</FONT></TD></TR></TABLE>>];
b [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white" POINT-SIZE="15"><B>文件起始偏移</B></FONT></TD></TR><TR><TD BGCOLOR="#F0F9FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">offset % 512 == 0<BR ALIGN="LEFT"/>示例 offset = 512</FONT></TD></TR></TABLE>>];
c [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white" POINT-SIZE="15"><B>本次传输长度</B></FONT></TD></TR><TR><TD BGCOLOR="#F0F9FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">length % 512 == 0<BR ALIGN="LEFT"/>示例 length = 1024</FONT></TD></TR></TABLE>>];
d [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0D9488"><FONT COLOR="white" POINT-SIZE="15"><B>三个条件同时满足</B></FONT></TD></TR><TR><TD BGCOLOR="#F0FDFA" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">只说明满足这里的对齐条件<BR ALIGN="LEFT"/>仍需检查文件系统支持及 I/O 结果</FONT></TD></TR></TABLE>>];
a -> d [label="地址", color="#0284C7", fontcolor="#0284C7"];
b -> d [label="偏移", color="#0284C7", fontcolor="#0284C7"];
c -> d [label="长度", color="#0284C7", fontcolor="#0284C7"];
{rank=same; a; b; c;}
}
