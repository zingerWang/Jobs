digraph G {
graph [rankdir=LR, bgcolor="white", dpi=200, pad=0.3, nodesep=0.22, ranksep=0.6, fontname="PingFang SC", labelloc=t, label=<<FONT POINT-SIZE="24" COLOR="#1E293B"><B>writev：多块内存组成一串待写字节</B></FONT><BR/><FONT POINT-SIZE="13" COLOR="#64748B">内核按列表顺序取数据；返回值是总字节数，不是完成的缓冲区数量</FONT>>];
node [shape=plaintext, fontname="PingFang SC"];
edge [fontname="PingFang SC", fontsize=11, arrowsize=0.7, arrowhead=normal, penwidth=1.3];
a [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#4F46E5"><FONT COLOR="white" POINT-SIZE="15"><B>两块原始内存</B></FONT></TD></TR><TR><TD BGCOLOR="#EEF2FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">iov[0] → HEAD，长度 4<BR ALIGN="LEFT"/>iov[1] → hello，长度 5</FONT></TD></TR></TABLE>>];
b [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white" POINT-SIZE="15"><B>逻辑顺序 HEADhello</B></FONT></TD></TR><TR><TD BGCOLOR="#F0F9FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">无需先在用户态拼接<BR ALIGN="LEFT"/>假设本次返回 6</FONT></TD></TR></TABLE>>];
c [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0D9488"><FONT COLOR="white" POINT-SIZE="15"><B>已写 HEADhe</B></FONT></TD></TR><TR><TD BGCOLOR="#F0FDFA" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">第一个缓冲区全部完成<BR ALIGN="LEFT"/>第二个完成前 2 字节</FONT></TD></TR></TABLE>>];
d [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#D97706"><FONT COLOR="white" POINT-SIZE="15"><B>下一次只写 llo</B></FONT></TD></TR><TR><TD BGCOLOR="#FFFBEB" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">从正文地址 + 2 开始<BR ALIGN="LEFT"/>剩余长度为 3</FONT></TD></TR></TABLE>>];
a -> b [label="writev", color="#0284C7", fontcolor="#0284C7"];
b -> c [label="接受 6 字节", color="#0D9488", fontcolor="#0D9488"];
c -> d [label="更新 iovec", color="#D97706", fontcolor="#D97706"];

}
