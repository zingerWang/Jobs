digraph G {
graph [rankdir=LR, bgcolor="white", dpi=200, pad=0.3, nodesep=0.22, ranksep=0.6, fontname="PingFang SC", labelloc=t, label=<<FONT POINT-SIZE="24" COLOR="#1E293B"><B>Linux 文件 I/O：知识关系图</B></FONT><BR/><FONT POINT-SIZE="13" COLOR="#64748B">分清操作哪个对象、数据到哪一步、何时完成和释放资源</FONT>>];
node [shape=plaintext, fontname="PingFang SC"];
edge [fontname="PingFang SC", fontsize=11, arrowsize=0.7, arrowhead=normal, penwidth=1.3];
root [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#4F46E5"><FONT COLOR="white" POINT-SIZE="15"><B>Linux 文件 I/O</B></FONT></TD></TR><TR><TD BGCOLOR="#EEF2FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">对象与偏移 → 缓冲与持久化<BR ALIGN="LEFT"/>映射、零拷贝与异步读写</FONT></TD></TR></TABLE>>];
n0 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white" POINT-SIZE="15"><B>一、对象关系</B></FONT></TD></TR><TR><TD BGCOLOR="#F0F9FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">fd → 打开文件描述 → inode<BR ALIGN="LEFT"/>dup 共享偏移；独立 open 分离偏移</FONT></TD></TR></TABLE>>];
n1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white" POINT-SIZE="15"><B>二、基础读写</B></FONT></TD></TR><TR><TD BGCOLOR="#F0F9FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">open / read / write / close / lseek<BR ALIGN="LEFT"/>页缓存取数据；短写推进指针与长度</FONT></TD></TR></TABLE>>];
n2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white" POINT-SIZE="15"><B>三、控制与复制</B></FONT></TD></TR><TR><TD BGCOLOR="#F0F9FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">fcntl 区分状态标志与 fd 标志<BR ALIGN="LEFT"/>dup2 让指定 fd 改为指向另一个文件</FONT></TD></TR></TABLE>>];
n3 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white" POINT-SIZE="15"><B>四、分散聚集 I/O</B></FONT></TD></TR><TR><TD BGCOLOR="#F0F9FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">readv / writev 组织多块缓冲区<BR ALIGN="LEFT"/>处理部分完成，不创造消息边界</FONT></TD></TR></TABLE>>];
n4 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#E11D48"><FONT COLOR="white" POINT-SIZE="15"><B>五、指定偏移</B></FONT></TD></TR><TR><TD BGCOLOR="#FFF1F2" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">pread / pwrite 避免共享偏移竞争<BR ALIGN="LEFT"/>不是业务事务或断电原子写</FONT></TD></TR></TABLE>>];
n5 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#D97706"><FONT COLOR="white" POINT-SIZE="15"><B>六、两层缓冲</B></FONT></TD></TR><TR><TD BGCOLOR="#FFFBEB" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">stdio 用户缓冲与内核页缓存<BR ALIGN="LEFT"/>fflush 不等于 fsync</FONT></TD></TR></TABLE>>];
n6 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0D9488"><FONT COLOR="white" POINT-SIZE="15"><B>七、持久化</B></FONT></TD></TR><TR><TD BGCOLOR="#F0FDFA" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">fsync / fdatasync / sync 范围不同<BR ALIGN="LEFT"/>临时文件同步 → rename → 目录同步</FONT></TD></TR></TABLE>>];
n7 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#7C3AED"><FONT COLOR="white" POINT-SIZE="15"><B>八、直接 I/O</B></FONT></TD></TR><TR><TD BGCOLOR="#F5F3FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">O_DIRECT：支持、地址与长度对齐<BR ALIGN="LEFT"/>不等于更快，不等于持久化</FONT></TD></TR></TABLE>>];
n8 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#475569"><FONT COLOR="white" POINT-SIZE="15"><B>九、文件元信息</B></FONT></TD></TR><TR><TD BGCOLOR="#F8FAFC" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">stat 路径；fstat 已打开对象<BR ALIGN="LEFT"/>权限取决于 mode / umask / ACL</FONT></TD></TR></TABLE>>];
n9 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#7C3AED"><FONT COLOR="white" POINT-SIZE="15"><B>十、映射与分配</B></FONT></TD></TR><TR><TD BGCOLOR="#F5F3FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">缺页时补映射；私有写复制页面<BR ALIGN="LEFT"/>brk / mmap 支撑分配器，free 可先缓存</FONT></TD></TR></TABLE>>];
n10 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white" POINT-SIZE="15"><B>十一、零拷贝</B></FONT></TD></TR><TR><TD BGCOLOR="#F0F9FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">sendfile / splice 减少用户态中转<BR ALIGN="LEFT"/>tee 保留原数据；接收方慢时需要等待</FONT></TD></TR></TABLE>>];
n11 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#7C3AED"><FONT COLOR="white" POINT-SIZE="15"><B>十二、I/O 模型</B></FONT></TD></TR><TR><TD BGCOLOR="#F5F3FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">epoll 等就绪；ET 读到 EAGAIN<BR ALIGN="LEFT"/>io_uring 按请求识别完成，再复用缓冲区</FONT></TD></TR></TABLE>>];
n12 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0D9488"><FONT COLOR="white" POINT-SIZE="15"><B>十三、选型与验证</B></FONT></TD></TR><TR><TD BGCOLOR="#F0FDFA" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">按负载、缓存、块大小和队列深度比较<BR ALIGN="LEFT"/>正确性、吞吐、尾延迟及实际验证范围</FONT></TD></TR></TABLE>>];
n13 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#475569"><FONT COLOR="white" POINT-SIZE="15"><B>十四、面试与 Q&amp;A</B></FONT></TD></TR><TR><TD BGCOLOR="#F8FAFC" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">问题 → 机制 → 取舍<BR ALIGN="LEFT"/>以失败路径和边界检验理解</FONT></TD></TR></TABLE>>];
root -> n0 [label="", color="#0284C7", fontcolor="#0284C7"];
root -> n1 [label="", color="#0284C7", fontcolor="#0284C7"];
root -> n2 [label="", color="#0284C7", fontcolor="#0284C7"];
root -> n3 [label="", color="#0284C7", fontcolor="#0284C7"];
root -> n4 [label="", color="#E11D48", fontcolor="#E11D48"];
root -> n5 [label="", color="#D97706", fontcolor="#D97706"];
root -> n6 [label="", color="#0D9488", fontcolor="#0D9488"];
root -> n7 [label="", color="#7C3AED", fontcolor="#7C3AED"];
root -> n8 [label="", color="#475569", fontcolor="#475569"];
root -> n9 [label="", color="#7C3AED", fontcolor="#7C3AED"];
root -> n10 [label="", color="#0284C7", fontcolor="#0284C7"];
root -> n11 [label="", color="#7C3AED", fontcolor="#7C3AED"];
root -> n12 [label="", color="#0D9488", fontcolor="#0D9488"];
root -> n13 [label="", color="#475569", fontcolor="#475569"];

