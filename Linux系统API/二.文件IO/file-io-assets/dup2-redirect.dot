digraph G {
graph [rankdir=LR, bgcolor="white", dpi=200, pad=0.3, nodesep=0.22, ranksep=0.6, fontname="PingFang SC", labelloc=t, label=<<FONT POINT-SIZE="24" COLOR="#1E293B"><B>dup2(3, 1)：替换 fd 1 的指向</B></FONT><BR/><FONT POINT-SIZE="13" COLOR="#64748B">复制的是引用；不会把终端内容复制进文件，也不会新建独立偏移</FONT>>];
node [shape=plaintext, fontname="PingFang SC"];
edge [fontname="PingFang SC", fontsize=11, arrowsize=0.7, arrowhead=normal, penwidth=1.3];
a [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#4F46E5"><FONT COLOR="white" POINT-SIZE="15"><B>调用前：fd 1</B></FONT></TD></TR><TR><TD BGCOLOR="#EEF2FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">标准输出入口</FONT></TD></TR></TABLE>>];
b [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#475569"><FONT COLOR="white" POINT-SIZE="15"><B>终端打开记录</B></FONT></TD></TR><TR><TD BGCOLOR="#F8FAFC" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">原来的输出目标</FONT></TD></TR></TABLE>>];
c [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#4F46E5"><FONT COLOR="white" POINT-SIZE="15"><B>调用前：fd 3</B></FONT></TD></TR><TR><TD BGCOLOR="#EEF2FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">open(&quot;out.txt&quot;) 的结果</FONT></TD></TR></TABLE>>];
d [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white" POINT-SIZE="15"><B>文件打开记录</B></FONT></TD></TR><TR><TD BGCOLOR="#F0F9FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">out.txt；当前偏移</FONT></TD></TR></TABLE>>];
e [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0D9488"><FONT COLOR="white" POINT-SIZE="15"><B>调用后：fd 1 和 fd 3</B></FONT></TD></TR><TR><TD BGCOLOR="#F0FDFA" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">两个号码共用同一打开记录<BR ALIGN="LEFT"/>close(3) 后 fd 1 仍可写</FONT></TD></TR></TABLE>>];
a -> b [label="原引用", color="#475569", fontcolor="#475569"];
c -> d [label="原引用", color="#0284C7", fontcolor="#0284C7"];
e -> d [label="dup2 后共同引用", color="#0D9488", fontcolor="#0D9488"];
{rank=same; a; c; e;} {rank=same; b; d;}
}
