digraph G {
graph [rankdir=LR, bgcolor="white", dpi=200, pad=0.3, nodesep=0.22, ranksep=0.6, fontname="PingFang SC", labelloc=t, label=<<FONT POINT-SIZE="24" COLOR="#1E293B"><B>mmap：建立地址关系，访问时才可能补上页面</B></FONT><BR/><FONT POINT-SIZE="13" COLOR="#64748B">示例页大小 4096；p 映射文件起点，p[5000] 位于第二页内偏移 904</FONT>>];
node [shape=plaintext, fontname="PingFang SC"];
edge [fontname="PingFang SC", fontsize=11, arrowsize=0.7, arrowhead=normal, penwidth=1.3];
a [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#4F46E5"><FONT COLOR="white" POINT-SIZE="15"><B>mmap 返回 p</B></FONT></TD></TR><TR><TD BGCOLOR="#EEF2FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">内核记录地址区间对应文件<BR ALIGN="LEFT"/>不表示全部数据已在内存</FONT></TD></TR></TABLE>>];
b [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#D97706"><FONT COLOR="white" POINT-SIZE="15"><B>访问 p[5000]</B></FONT></TD></TR><TR><TD BGCOLOR="#FFFBEB" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">页表已有可用映射：直接访问<BR ALIGN="LEFT"/>否则触发缺页处理</FONT></TD></TR></TABLE>>];
c [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white" POINT-SIZE="15"><B>内核查找文件页面</B></FONT></TD></TR><TR><TD BGCOLOR="#F0F9FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">缓存有数据：可直接用<BR ALIGN="LEFT"/>缓存没有：先等待设备读入</FONT></TD></TR></TABLE>>];
d [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0D9488"><FONT COLOR="white" POINT-SIZE="15"><B>建立页表映射</B></FONT></TD></TR><TR><TD BGCOLOR="#F0FDFA" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">重新执行刚才的访问<BR ALIGN="LEFT"/>从对应页面取得数据</FONT></TD></TR></TABLE>>];
a -> b [label="应用访问", color="#0284C7", fontcolor="#0284C7"];
b -> c [label="需要补映射", color="#D97706", fontcolor="#D97706"];
c -> d [label="页面可用", color="#0D9488", fontcolor="#0D9488"];

}
