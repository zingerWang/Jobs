digraph G {
graph [rankdir=LR, bgcolor="white", dpi=200, pad=0.3, nodesep=0.22, ranksep=0.6, fontname="PingFang SC", labelloc=t, label=<<FONT POINT-SIZE="24" COLOR="#1E293B"><B>io_uring：按请求编号找回结果，再复用对应缓冲区</B></FONT><BR/><FONT POINT-SIZE="13" COLOR="#64748B">仅示意普通单次 READ 请求；提交先后不决定完成先后</FONT>>];
node [shape=plaintext, fontname="PingFang SC"];
edge [fontname="PingFang SC", fontsize=11, arrowsize=0.7, arrowhead=normal, penwidth=1.3];
a [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#4F46E5"><FONT COLOR="white" POINT-SIZE="15"><B>先提交 A，再提交 B</B></FONT></TD></TR><TR><TD BGCOLOR="#EEF2FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">A：offset 0，bufA<BR ALIGN="LEFT"/>B：offset 4096，bufB</FONT></TD></TR></TABLE>>];
b [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#D97706"><FONT COLOR="white" POINT-SIZE="15"><B>两个请求尚未完成</B></FONT></TD></TR><TR><TD BGCOLOR="#FFFBEB" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">内核可能仍向缓冲区写入<BR ALIGN="LEFT"/>bufA 和 bufB 均不能复用</FONT></TD></TR></TABLE>>];
c [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white" POINT-SIZE="15"><B>先收到 B 的 CQE</B></FONT></TD></TR><TR><TD BGCOLOR="#F0F9FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">通过 user_data 识别 B<BR ALIGN="LEFT"/>处理 B 的结果后可复用 bufB<BR ALIGN="LEFT"/>bufA 仍须保留</FONT></TD></TR></TABLE>>];
d [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0D9488"><FONT COLOR="white" POINT-SIZE="15"><B>后收到 A 的 CQE</B></FONT></TD></TR><TR><TD BGCOLOR="#F0FDFA" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">识别并处理 A 的结果<BR ALIGN="LEFT"/>此时才可复用 bufA</FONT></TD></TR></TABLE>>];
a -> b [label="提交成功", color="#D97706", fontcolor="#D97706"];
b -> c [label="B 先完成", color="#0284C7", fontcolor="#0284C7"];
c -> d [label="A 后完成", color="#0D9488", fontcolor="#0D9488"];

}
