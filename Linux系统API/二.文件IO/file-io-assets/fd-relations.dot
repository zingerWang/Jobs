digraph G {
graph [rankdir=LR, bgcolor="white", dpi=200, pad=0.3, nodesep=0.22, ranksep=0.6, fontname="PingFang SC", labelloc=t, label=<<FONT POINT-SIZE="24" COLOR="#1E293B"><B>文件描述符：号码、打开状态与文件对象</B></FONT><BR/><FONT POINT-SIZE="13" COLOR="#64748B">dup 复制引用；独立 open 建立独立偏移；inode 不保存每次打开的进度</FONT>>];
node [shape=plaintext, fontname="PingFang SC"];
edge [fontname="PingFang SC", fontsize=11, arrowsize=0.7, arrowhead=normal, penwidth=1.3];
fd3 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#4F46E5"><FONT COLOR="white" POINT-SIZE="15"><B>fd 3</B></FONT></TD></TR><TR><TD BGCOLOR="#EEF2FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">open 得到的描述符</FONT></TD></TR></TABLE>>];
fd4 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#4F46E5"><FONT COLOR="white" POINT-SIZE="15"><B>fd 4</B></FONT></TD></TR><TR><TD BGCOLOR="#EEF2FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">dup(3) 得到的新号码</FONT></TD></TR></TABLE>>];
fd5 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#4F46E5"><FONT COLOR="white" POINT-SIZE="15"><B>fd 5</B></FONT></TD></TR><TR><TD BGCOLOR="#EEF2FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">再次 open 同一路径</FONT></TD></TR></TABLE>>];
a [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white" POINT-SIZE="15"><B>打开文件描述 A</B></FONT></TD></TR><TR><TD BGCOLOR="#F0F9FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">fd 3 与 fd 4 共用下一次读写的位置<BR ALIGN="LEFT"/>共用 O_APPEND / O_NONBLOCK 等设置</FONT></TD></TR></TABLE>>];
b [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white" POINT-SIZE="15"><B>打开文件描述 B</B></FONT></TD></TR><TR><TD BGCOLOR="#F0F9FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">自己的文件偏移<BR ALIGN="LEFT"/>自己的状态标志</FONT></TD></TR></TABLE>>];
inode [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0D9488"><FONT COLOR="white" POINT-SIZE="15"><B>同一个文件对象</B></FONT></TD></TR><TR><TD BGCOLOR="#F0FDFA" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">inode：属性、大小、数据定位<BR ALIGN="LEFT"/>与文件数据页缓存关联</FONT></TD></TR></TABLE>>];
path [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#475569"><FONT COLOR="white" POINT-SIZE="15"><B>目录项 / 文件名</B></FONT></TD></TR><TR><TD BGCOLOR="#F8FAFC" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">名字查找定位对象<BR ALIGN="LEFT"/>rename 不切换已有 fd 的引用</FONT></TD></TR></TABLE>>];
fd3 -> a [label="引用", color="#0284C7", fontcolor="#0284C7"];
fd4 -> a [label="引用", color="#0284C7", fontcolor="#0284C7"];
fd5 -> b [label="引用", color="#0284C7", fontcolor="#0284C7"];
a -> inode [label="", color="#0284C7", fontcolor="#0284C7"];
b -> inode [label="", color="#0284C7", fontcolor="#0284C7"];
path -> inode [label="查找", color="#475569", fontcolor="#475569"];

}
