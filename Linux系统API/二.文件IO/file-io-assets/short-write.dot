digraph G {
graph [rankdir=LR, bgcolor="white", dpi=200, pad=0.3, nodesep=0.22, ranksep=0.6, fontname="PingFang SC", labelloc=t, label=<<FONT POINT-SIZE="24" COLOR="#1E293B"><B>短写：下一次从尚未写出的字节开始</B></FONT><BR/><FONT POINT-SIZE="13" COLOR="#64748B">假设三次 write 分别返回 3、2、3；这只是演示进度，并非固定行为</FONT>>];
node [shape=plaintext, fontname="PingFang SC"];
edge [fontname="PingFang SC", fontsize=11, arrowsize=0.7, arrowhead=normal, penwidth=1.3];
a [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#4F46E5"><FONT COLOR="white" POINT-SIZE="15"><B>第一次：ABCDEFGH</B></FONT></TD></TR><TR><TD BGCOLOR="#EEF2FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">指针 buf + 0，长度 8<BR ALIGN="LEFT"/>返回 3：ABC 已接受</FONT></TD></TR></TABLE>>];
b [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white" POINT-SIZE="15"><B>第二次：DEFGH</B></FONT></TD></TR><TR><TD BGCOLOR="#F0F9FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">指针 buf + 3，长度 5<BR ALIGN="LEFT"/>返回 2：DE 已接受</FONT></TD></TR></TABLE>>];
c [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white" POINT-SIZE="15"><B>第三次：FGH</B></FONT></TD></TR><TR><TD BGCOLOR="#F0F9FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">指针 buf + 5，长度 3<BR ALIGN="LEFT"/>返回 3：FGH 已接受</FONT></TD></TR></TABLE>>];
d [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0D9488"><FONT COLOR="white" POINT-SIZE="15"><B>8 字节全部交出</B></FONT></TD></TR><TR><TD BGCOLOR="#F0FDFA" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">普通 write 推进文件偏移<BR ALIGN="LEFT"/>应用维护指针和剩余长度</FONT></TD></TR></TABLE>>];
a -> b [label="推进 3", color="#0284C7", fontcolor="#0284C7"];
b -> c [label="推进 2", color="#0284C7", fontcolor="#0284C7"];
c -> d [label="推进 3", color="#0D9488", fontcolor="#0D9488"];

}
