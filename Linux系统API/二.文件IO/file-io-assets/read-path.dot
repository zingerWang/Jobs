digraph G {
graph [rankdir=LR, bgcolor="white", dpi=200, pad=0.3, nodesep=0.22, ranksep=0.6, fontname="PingFang SC", labelloc=t, label=<<FONT POINT-SIZE="24" COLOR="#1E293B"><B>read：先找到文件，再取得这次要读的字节</B></FONT><BR/><FONT POINT-SIZE="13" COLOR="#64748B">示例：文件 ABCDE，当前偏移 2，申请读取 2 字节；普通缓冲 I/O</FONT>>];
node [shape=plaintext, fontname="PingFang SC"];
edge [fontname="PingFang SC", fontsize=11, arrowsize=0.7, arrowhead=normal, penwidth=1.3];
a [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#4F46E5"><FONT COLOR="white" POINT-SIZE="15"><B>应用发起 read</B></FONT></TD></TR><TR><TD BGCOLOR="#EEF2FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">fd 指向打开记录<BR ALIGN="LEFT"/>本次范围 [2, 4)</FONT></TD></TR></TABLE>>];
b [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#D97706"><FONT COLOR="white" POINT-SIZE="15"><B>查找文件页缓存</B></FONT></TD></TR><TR><TD BGCOLOR="#FFFBEB" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">命中：已有可用数据<BR ALIGN="LEFT"/>未命中：需要从设备读取</FONT></TD></TR></TABLE>>];
c [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white" POINT-SIZE="15"><B>文件系统与设备</B></FONT></TD></TR><TR><TD BGCOLOR="#F0F9FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">读取需要的文件内容<BR ALIGN="LEFT"/>填入内核页缓存</FONT></TD></TR></TABLE>>];
d [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0D9488"><FONT COLOR="white" POINT-SIZE="15"><B>复制到用户数组</B></FONT></TD></TR><TR><TD BGCOLOR="#F0FDFA" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">buf 得到 C、D<BR ALIGN="LEFT"/>此次返回 2，偏移变成 4</FONT></TD></TR></TABLE>>];
a -> b [label="找到对象和位置", color="#0284C7", fontcolor="#0284C7"];
b -> c [label="未命中", color="#D97706", fontcolor="#D97706"];
b -> d [label="命中", color="#0D9488", fontcolor="#0D9488"];
c -> d [label="数据就绪", color="#0284C7", fontcolor="#0284C7"];

}
