digraph G {
graph [rankdir=LR, bgcolor="white", dpi=200, pad=0.3, nodesep=0.22, ranksep=0.6, fontname="PingFang SC", labelloc=t, label=<<FONT POINT-SIZE="24" COLOR="#1E293B"><B>可靠替换配置：内容和名字分别保存</B></FONT><BR/><FONT POINT-SIZE="13" COLOR="#64748B">每一步都要检查返回值；临时文件与目标位于同一目录，假设系统支持相应同步</FONT>>];
node [shape=plaintext, fontname="PingFang SC"];
edge [fontname="PingFang SC", fontsize=11, arrowsize=0.7, arrowhead=normal, penwidth=1.3];
a [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#4F46E5"><FONT COLOR="white" POINT-SIZE="15"><B>① 写临时文件</B></FONT></TD></TR><TR><TD BGCOLOR="#EEF2FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">新文件内容 version=2<BR ALIGN="LEFT"/>目标名仍指向旧版本</FONT></TD></TR></TABLE>>];
b [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0D9488"><FONT COLOR="white" POINT-SIZE="15"><B>② fsync 临时文件</B></FONT></TD></TR><TR><TD BGCOLOR="#F0FDFA" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">等待新文件内容同步<BR ALIGN="LEFT"/>目标名仍未切换</FONT></TD></TR></TABLE>>];
c [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white" POINT-SIZE="15"><B>③ rename 替换名字</B></FONT></TD></TR><TR><TD BGCOLOR="#F0F9FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">新打开目标名得到新文件<BR ALIGN="LEFT"/>旧 fd 仍指向旧文件</FONT></TD></TR></TABLE>>];
d [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0D9488"><FONT COLOR="white" POINT-SIZE="15"><B>④ fsync 父目录</B></FONT></TD></TR><TR><TD BGCOLOR="#F0FDFA" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">保存名字替换的结果<BR ALIGN="LEFT"/>成功后再报告保存完成</FONT></TD></TR></TABLE>>];
a -> b [label="内容先准备好", color="#0284C7", fontcolor="#0284C7"];
b -> c [label="再让新读者找到它", color="#0284C7", fontcolor="#0284C7"];
c -> d [label="名字变更也需同步", color="#0D9488", fontcolor="#0D9488"];

}
