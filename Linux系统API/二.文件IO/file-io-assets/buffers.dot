digraph G {
graph [rankdir=LR, bgcolor="white", dpi=200, pad=0.3, nodesep=0.22, ranksep=0.6, fontname="PingFang SC", labelloc=t, label=<<FONT POINT-SIZE="24" COLOR="#1E293B"><B>数据走到哪一步，决定了什么保证</B></FONT><BR/><FONT POINT-SIZE="13" COLOR="#64748B">fflush 交出用户态缓冲；fsync 等待文件同步；名字变更还需目录同步</FONT>>];
node [shape=plaintext, fontname="PingFang SC"];
edge [fontname="PingFang SC", fontsize=11, arrowsize=0.7, arrowhead=normal, penwidth=1.3];
app [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#4F46E5"><FONT COLOR="white" POINT-SIZE="15"><B>应用调用</B></FONT></TD></TR><TR><TD BGCOLOR="#EEF2FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">按所选 I/O 路径提交</FONT></TD></TR></TABLE>>];
stdio [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#4F46E5"><FONT COLOR="white" POINT-SIZE="15"><B>stdio 缓冲</B></FONT></TD></TR><TR><TD BGCOLOR="#EEF2FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">进程用户空间<BR ALIGN="LEFT"/>合并小输出</FONT></TD></TR></TABLE>>];
page [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#D97706"><FONT COLOR="white" POINT-SIZE="15"><B>内核页缓存</B></FONT></TD></TR><TR><TD BGCOLOR="#FFFBEB" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">普通 write 通常先到这里<BR ALIGN="LEFT"/>内存中可读，不代表已经落盘</FONT></TD></TR></TABLE>>];
device [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0D9488"><FONT COLOR="white" POINT-SIZE="15"><B>文件系统与存储设备</B></FONT></TD></TR><TR><TD BGCOLOR="#F0FDFA" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">把内存中的修改写到存储设备<BR ALIGN="LEFT"/>等待并检查同步是否完成</FONT></TD></TR></TABLE>>];
direct [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#7C3AED"><FONT COLOR="white" POINT-SIZE="15"><B>O_DIRECT</B></FONT></TD></TR><TR><TD BGCOLOR="#F5F3FF" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">受支持的直接 I/O 路径<BR ALIGN="LEFT"/>对齐要求；不等于 O_SYNC</FONT></TD></TR></TABLE>>];
dir [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#475569"><FONT COLOR="white" POINT-SIZE="15"><B>目录状态</B></FONT></TD></TR><TR><TD BGCOLOR="#F8FAFC" ALIGN="LEFT"><FONT COLOR="#1E293B" POINT-SIZE="12">创建 / rename 修改名字关系<BR ALIGN="LEFT"/>需要时 fsync 父目录</FONT></TD></TR></TABLE>>];
app -> stdio [label="fprintf / fwrite", color="#4F46E5", fontcolor="#4F46E5"];
stdio -> page [label="fflush → write", color="#0284C7", fontcolor="#0284C7"];
page -> device [label="回写 / fsync / fdatasync", color="#0D9488", fontcolor="#0D9488"];
app -> direct [label="O_DIRECT fd + write", color="#7C3AED", fontcolor="#7C3AED"];
direct -> device [label="需要时仍要 fsync", color="#7C3AED", fontcolor="#7C3AED"];
dir -> device [label="目录 fsync", color="#475569", fontcolor="#475569"];

}
