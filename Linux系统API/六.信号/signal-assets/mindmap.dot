digraph signals {
  graph [rankdir=LR, bgcolor="white", dpi=200, pad=0.25, nodesep=0.12, ranksep=0.5, fontname="PingFang SC", labelloc=t, labeljust=c, label=<<FONT POINT-SIZE="24" COLOR="#1E293B"><B>Linux 信号</B></FONT><BR/><FONT POINT-SIZE="13" COLOR="#64748B">从 Ctrl+C 到子进程回收</FONT>>];
  node [shape=plaintext, fontname="PingFang SC"];
  edge [arrowhead=normal, arrowsize=0.7, penwidth=1.3];
  root [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#475569"><FONT COLOR="white"><B>Linux 信号</B></FONT></TD></TR><TR><TD BGCOLOR="#F8FAFC"><FONT POINT-SIZE="11" COLOR="#1E293B">产生 → 待处理 → 递达<BR/>线程在何时、何处接收</FONT></TD></TR></TABLE>>];
  n0 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#4F46E5"><FONT COLOR="white"><B>信号基础</B></FONT></TD></TR><TR><TD BGCOLOR="#EEF2FF"><FONT POINT-SIZE="11" COLOR="#1E293B">来源与默认动作<BR/>标准信号合并，实时信号排队</FONT></TD></TR></TABLE>>];
  root -> n0 [color="#4F46E5"];
  n1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white"><B>发送与接收</B></FONT></TD></TR><TR><TD BGCOLOR="#F0F9FF"><FONT POINT-SIZE="11" COLOR="#1E293B">kill / raise<BR/>signal / sigaction</FONT></TD></TR></TABLE>>];
  root -> n1 [color="#0284C7"];
  n2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#D97706"><FONT COLOR="white"><B>屏蔽与等待</B></FONT></TD></TR><TR><TD BGCOLOR="#FFFBEB"><FONT POINT-SIZE="11" COLOR="#1E293B">信号集、屏蔽字、待处理集合<BR/>sigsuspend 原子换表并等待</FONT></TD></TR></TABLE>>];
  root -> n2 [color="#D97706"];
  n3 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#E11D48"><FONT COLOR="white"><B>信号打断程序</B></FONT></TD></TR><TR><TD BGCOLOR="#FFF1F2"><FONT POINT-SIZE="11" COLOR="#1E293B">EINTR、异步信号安全<BR/>SIGCHLD、SIGPIPE、替代栈</FONT></TD></TR></TABLE>>];
  root -> n3 [color="#E11D48"];
  n4 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#7C3AED"><FONT COLOR="white"><B>多线程</B></FONT></TD></TR><TR><TD BGCOLOR="#F5F3FF"><FONT POINT-SIZE="11" COLOR="#1E293B">线程屏蔽字、定向发送<BR/>pthread_sigmask / pthread_kill / sigwait</FONT></TD></TR></TABLE>>];
  root -> n4 [color="#7C3AED"];
  n5 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#0D9488"><FONT COLOR="white"><B>实验与排错</B></FONT></TD></TR><TR><TD BGCOLOR="#F0FDFA"><FONT POINT-SIZE="11" COLOR="#1E293B">四个 C++ 示例与管道实验<BR/>检查僵尸、屏蔽字和死锁</FONT></TD></TR></TABLE>>];
  root -> n5 [color="#0D9488"];
  n6 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#475569"><FONT COLOR="white"><B>面试与问答</B></FONT></TD></TR><TR><TD BGCOLOR="#F8FAFC"><FONT POINT-SIZE="11" COLOR="#1E293B">产生、递达与处理<BR/>通知次数与事件次数</FONT></TD></TR></TABLE>>];
  root -> n6 [color="#475569"];
}
