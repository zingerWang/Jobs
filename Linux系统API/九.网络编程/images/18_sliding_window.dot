digraph sliding_window {
    rankdir=TB;
    graph [fontname="PingFang SC", bgcolor="white", pad=0.5, nodesep=0.5, ranksep=0.5, label=<<FONT POINT-SIZE="24" COLOR="#1E293B"><B>滑动窗口与流量控制</B></FONT><BR/><FONT POINT-SIZE="13" COLOR="#64748B">发送方「已发未确认」的数据量不能超过对端通告的窗口（= 对端接收缓冲大小）</FONT>>, labelloc=t, fontname="PingFang SC"];
    node [fontname="PingFang SC", shape=plaintext, margin=0];
    edge [fontname="PingFang SC", fontsize=12, color="#64748B", penwidth=1.4, arrowsize=0.9];

    stream [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#475569" COLOR="white" ALIGN="CENTER" CELLPADDING="6" COLSPAN="10"><FONT POINT-SIZE="13"><B>发送方的字节流（序号 1～10）</B></FONT></TD></TR>
  <TR>
    <TD BGCOLOR="#DCFCE7" COLOR="#166534" ALIGN="CENTER" WIDTH="34" CELLPADDING="9"><FONT FACE="Menlo" POINT-SIZE="13"><B>1</B></FONT></TD>
    <TD BGCOLOR="#DCFCE7" COLOR="#166534" ALIGN="CENTER" WIDTH="34" CELLPADDING="9"><FONT FACE="Menlo" POINT-SIZE="13"><B>2</B></FONT></TD>
    <TD BGCOLOR="#DCFCE7" COLOR="#166534" ALIGN="CENTER" WIDTH="34" CELLPADDING="9"><FONT FACE="Menlo" POINT-SIZE="13"><B>3</B></FONT></TD>
    <TD BGCOLOR="#DCFCE7" COLOR="#166534" ALIGN="CENTER" WIDTH="34" CELLPADDING="9"><FONT FACE="Menlo" POINT-SIZE="13"><B>4</B></FONT></TD>
    <TD BGCOLOR="#FEF3C7" COLOR="#92400E" ALIGN="CENTER" WIDTH="34" CELLPADDING="9"><FONT FACE="Menlo" POINT-SIZE="13"><B>5</B></FONT></TD>
    <TD BGCOLOR="#FEF3C7" COLOR="#92400E" ALIGN="CENTER" WIDTH="34" CELLPADDING="9"><FONT FACE="Menlo" POINT-SIZE="13"><B>6</B></FONT></TD>
    <TD BGCOLOR="#FEF3C7" COLOR="#92400E" ALIGN="CENTER" WIDTH="34" CELLPADDING="9"><FONT FACE="Menlo" POINT-SIZE="13"><B>7</B></FONT></TD>
    <TD BGCOLOR="#DBEAFE" COLOR="#1E40AF" ALIGN="CENTER" WIDTH="34" CELLPADDING="9"><FONT FACE="Menlo" POINT-SIZE="13"><B>8</B></FONT></TD>
    <TD BGCOLOR="#DBEAFE" COLOR="#1E40AF" ALIGN="CENTER" WIDTH="34" CELLPADDING="9"><FONT FACE="Menlo" POINT-SIZE="13"><B>9</B></FONT></TD>
    <TD BGCOLOR="#E2E8F0" COLOR="#475569" ALIGN="CENTER" WIDTH="34" CELLPADDING="9"><FONT FACE="Menlo" POINT-SIZE="13"><B>10</B></FONT></TD>
  </TR>
  <TR>
    <TD BGCOLOR="#F0FDF4" ALIGN="CENTER" COLSPAN="4" CELLPADDING="6"><FONT POINT-SIZE="11" COLOR="#166534">已发送并确认</FONT></TD>
    <TD BGCOLOR="#FFFBEB" ALIGN="CENTER" COLSPAN="5" CELLPADDING="6"><FONT POINT-SIZE="11" COLOR="#92400E"><B>◀ 滑动窗口（共 5）▶</B></FONT></TD>
    <TD BGCOLOR="#F8FAFC" ALIGN="CENTER" COLSPAN="1" CELLPADDING="6"><FONT POINT-SIZE="11" COLOR="#475569">不可发送</FONT></TD>
  </TR>
</TABLE>>];

    legend [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#DCFCE7" ALIGN="CENTER" WIDTH="120" CELLPADDING="6"><FONT POINT-SIZE="11" COLOR="#166534">绿色：已确认</FONT></TD><TD BGCOLOR="#FEF3C7" ALIGN="CENTER" WIDTH="140" CELLPADDING="6"><FONT POINT-SIZE="11" COLOR="#92400E">黄色：已发未确认</FONT></TD><TD BGCOLOR="#DBEAFE" ALIGN="CENTER" WIDTH="100" CELLPADDING="6"><FONT POINT-SIZE="11" COLOR="#1E40AF">蓝色：可发送</FONT></TD><TD BGCOLOR="#E2E8F0" ALIGN="CENTER" WIDTH="100" CELLPADDING="6"><FONT POINT-SIZE="11" COLOR="#475569">灰色：不可发</FONT></TD></TR>
</TABLE>>];

    note [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#0D9488" COLOR="white" ALIGN="CENTER" CELLPADDING="7"><FONT POINT-SIZE="12"><B>窗口如何「滑动」</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#F0FDFA" ALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="11" COLOR="#0F766E">· 每收到一个 ACK，窗口右边界就向右移（滑动）<BR/>· 窗口大小 = 对端通告的接收缓冲大小（TCP 头 window 字段）<BR/>· 若对端来不及收（缓冲满），窗口缩为 0，发送方暂停发送</FONT></TD></TR>
</TABLE>>];

    stream -> legend [style=invis];
    legend -> note [style=invis];
}
