digraph four_way_handshake {
    rankdir=TB;
    graph [fontname="PingFang SC", bgcolor="white", pad=0.5, nodesep=0.7, ranksep=0.5, label=<<FONT POINT-SIZE="24" COLOR="#1E293B"><B>四次挥手（关闭连接）</B></FONT><BR/><FONT POINT-SIZE="13" COLOR="#64748B">主动关闭方进入 TIME_WAIT，等待 2MSL 后关闭</FONT>>, labelloc=t, fontname="PingFang SC"];
    node [fontname="PingFang SC", shape=plaintext, margin=0];
    edge [fontname="PingFang SC", fontsize=13, penwidth=1.8];

    // 列标题
    client_hdr [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#4F46E5" COLOR="white" ALIGN="CENTER" CELLPADDING="7"><FONT POINT-SIZE="16"><B>客户端（主动关闭方）</B></FONT></TD></TR>
</TABLE>>];
    server_hdr [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#0D9488" COLOR="white" ALIGN="CENTER" CELLPADDING="7"><FONT POINT-SIZE="16"><B>服务端（被动关闭方）</B></FONT></TD></TR>
</TABLE>>];

    // 客户端列
    a_est [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#0D9488" COLOR="white" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="13"><B>ESTABLISHED</B></FONT></TD></TR>
</TABLE>>];
    a_fw1 [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#E11D48" COLOR="white" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="13"><B>FIN_WAIT_1</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#FFF1F2" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="11" COLOR="#BE123C">close() 发送 FIN</FONT></TD></TR>
</TABLE>>];
    a_fw2 [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#D97706" COLOR="white" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="13"><B>FIN_WAIT_2</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#FFFBEB" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="11" COLOR="#B45309">收到 ACK，等待对端 FIN</FONT></TD></TR>
</TABLE>>];
    a_tw [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#7C3AED" COLOR="white" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="13"><B>TIME_WAIT</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#F5F3FF" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="11" COLOR="#6D28D9">等待 2MSL</FONT></TD></TR>
</TABLE>>];
    a_closed [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#475569" COLOR="white" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="13"><B>CLOSED</B></FONT></TD></TR>
</TABLE>>];

    // 服务端列
    b_est [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#0D9488" COLOR="white" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="13"><B>ESTABLISHED</B></FONT></TD></TR>
</TABLE>>];
    b_cw [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#D97706" COLOR="white" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="13"><B>CLOSE_WAIT</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#FFFBEB" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="11" COLOR="#B45309">收到 FIN，回 ACK</FONT></TD></TR>
</TABLE>>];
    b_la [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#E11D48" COLOR="white" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="13"><B>LAST_ACK</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#FFF1F2" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="11" COLOR="#BE123C">close() 发送 FIN</FONT></TD></TR>
</TABLE>>];
    b_closed [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#475569" COLOR="white" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="13"><B>CLOSED</B></FONT></TD></TR>
</TABLE>>];

    // 垂直顺序
    client_hdr -> a_est -> a_fw1 -> a_fw2 -> a_tw -> a_closed [style=invis];
    server_hdr -> b_est -> b_cw -> b_la -> b_closed [style=invis];

    // 水平对齐
    { rank=same; client_hdr; server_hdr; }
    { rank=same; a_fw1; b_cw; }
    { rank=same; a_fw2; b_la; }
    { rank=same; a_tw; b_closed; }

    // 报文
    a_fw1 -> b_cw [label="① FIN (seq=x)", color="#E11D48", fontcolor="#BE123C"];
    b_cw -> a_fw2  [label="② ACK (ack=x+1)", color="#0D9488", fontcolor="#0F766E"];
    b_la -> a_tw   [label="③ FIN (seq=y)", color="#E11D48", fontcolor="#BE123C"];
    a_tw -> b_closed [label="④ ACK (ack=y+1)", color="#0D9488", fontcolor="#0F766E"];

    // 2MSL 注释
    msl [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#7C3AED" COLOR="white" ALIGN="CENTER" CELLPADDING="7"><FONT POINT-SIZE="12"><B>为什么等 2MSL？</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#F5F3FF" ALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="11" COLOR="#6D28D9">· 保证最后 ACK 能送达（丢了可重发）<BR/>· 让旧连接报文在网络中自然消亡</FONT></TD></TR>
</TABLE>>];
    a_tw -> msl [style=dashed, color="#7C3AED", fontcolor="#6D28D9"];
}
