digraph epoll_waitqueue {
    rankdir=TB;
    compound=true;
    graph [fontname="PingFang SC", bgcolor="white", pad=0.4, nodesep=0.5, ranksep=0.4, label=<<FONT POINT-SIZE="24" COLOR="#1E293B"><B>epoll 的等待队列：从「通知管道」到「结果仓库」</B></FONT><BR/><FONT POINT-SIZE="13" COLOR="#64748B">等待队列挂在 socket 上（管「谁要通知」），就绪链表挂在 eventpoll 上（管「谁就绪了」）——两条不同的链表</FONT>>, labelloc=t, fontname="PingFang SC"];
    node [fontname="PingFang SC", shape=plaintext, margin=0];
    edge [fontname="PingFang SC", fontsize=12, color="#64748B", penwidth=1.8, arrowsize=1.0];

    data [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#0284C7" COLOR="white" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="13"><B>① 数据到达</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#F0F9FF" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="11" COLOR="#0369A1">网卡收到数据，协议栈处理</FONT></TD></TR>
</TABLE>>];

    rcvbuf [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#0284C7" COLOR="white" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="13"><B>② socket 接收缓冲区</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#F0F9FF" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="11" COLOR="#0369A1">sk_receive_queue<BR/>数据放进这里</FONT></TD></TR>
</TABLE>>];

    wq [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#E11D48" COLOR="white" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="13"><B>③ socket 的等待队列</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#FFF1F2" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="11" COLOR="#BE123C">wait_queue_head_t（挂在 socket 上）<BR/><B>「通知管道」</B>：登记了 ep_poll_callback</FONT></TD></TR>
</TABLE>>];

    callback [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#E11D48" COLOR="white" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="13"><B>④ ep_poll_callback 被唤醒</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#FFF1F2" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="11" COLOR="#BE123C">查一次就绪（调 poll 方法）<BR/>把 epitem 挂进就绪链表</FONT></TD></TR>
</TABLE>>];

    rlist [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#0D9488" COLOR="white" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="13"><B>⑤ eventpoll 的就绪链表</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#F0FDFA" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="11" COLOR="#0F766E">rdllist（挂在 eventpoll 上）<BR/><B>「结果仓库」</B>：就绪 fd 的名单</FONT></TD></TR>
</TABLE>>];

    epollwait [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#0D9488" COLOR="white" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="13"><B>⑥ epoll_wait 取走返回</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#F0FDFA" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="11" COLOR="#0F766E">被叫醒，从就绪链表<BR/>返回就绪 fd 给用户</FONT></TD></TR>
</TABLE>>];

    data -> rcvbuf [label="放进缓冲区", color="#0284C7", fontcolor="#0369A1"];
    rcvbuf -> wq [label="wake_up 通知", color="#0284C7", fontcolor="#0369A1"];
    wq -> callback [label="逐个调回调", color="#E11D48", fontcolor="#BE123C"];
    callback -> rlist [label="挂进链表", color="#E11D48", fontcolor="#BE123C"];
    rlist -> epollwait [label="取走", color="#0D9488", fontcolor="#0F766E"];
}
