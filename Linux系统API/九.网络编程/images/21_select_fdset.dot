digraph select_fdset {
    rankdir=TB;
    compound=true;
    graph [fontname="PingFang SC", bgcolor="white", pad=0.5, nodesep=0.5, ranksep=0.38, label=<<FONT POINT-SIZE="24" COLOR="#1E293B"><B>select：fd_set 位图结构 + 一次事件的处理流程</B></FONT><BR/><FONT POINT-SIZE="13" COLOR="#64748B">fd_set 是 1024 位位图，bit 序号 = fd 编号；select 每次全量拷贝 + 主动遍历逐个 poll</FONT>>, labelloc=t, fontname="PingFang SC"];
    node [fontname="PingFang SC", shape=plaintext, margin=0];
    edge [fontname="PingFang SC", fontsize=12, color="#64748B", penwidth=1.8, arrowsize=1.0];

    bitmap [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#4F46E5" COLOR="white" ALIGN="CENTER" CELLPADDING="7"><FONT POINT-SIZE="13"><B>fd_set 位图（底层是 unsigned long fds_bits[16]，64 位机 16×64 = 1024 位）</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#EEF2FF" ALIGN="CENTER" CELLPADDING="6">
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="0" COLOR="#E2E8F0">
      <TR>
        <TD BGCOLOR="#F8FAFC" CELLPADDING="3"><FONT POINT-SIZE="9" COLOR="#64748B">fd0</FONT><BR/><FONT POINT-SIZE="12" COLOR="#94A3B8"><B>0</B></FONT></TD>
        <TD BGCOLOR="#F8FAFC" CELLPADDING="3"><FONT POINT-SIZE="9" COLOR="#64748B">fd1</FONT><BR/><FONT POINT-SIZE="12" COLOR="#94A3B8"><B>0</B></FONT></TD>
        <TD BGCOLOR="#F8FAFC" CELLPADDING="3"><FONT POINT-SIZE="9" COLOR="#64748B">fd2</FONT><BR/><FONT POINT-SIZE="12" COLOR="#94A3B8"><B>0</B></FONT></TD>
        <TD BGCOLOR="#F8FAFC" CELLPADDING="3"><FONT POINT-SIZE="9" COLOR="#64748B">fd3</FONT><BR/><FONT POINT-SIZE="12" COLOR="#94A3B8"><B>0</B></FONT></TD>
        <TD BGCOLOR="#D1FAE5" CELLPADDING="3"><FONT POINT-SIZE="9" COLOR="#0F766E">fd4(lfd)</FONT><BR/><FONT POINT-SIZE="12" COLOR="#0D9488"><B>1</B></FONT></TD>
        <TD BGCOLOR="#F8FAFC" CELLPADDING="3"><FONT POINT-SIZE="9" COLOR="#64748B">fd5</FONT><BR/><FONT POINT-SIZE="12" COLOR="#94A3B8"><B>0</B></FONT></TD>
        <TD BGCOLOR="#F8FAFC" CELLPADDING="3"><FONT POINT-SIZE="9" COLOR="#64748B">fd6</FONT><BR/><FONT POINT-SIZE="12" COLOR="#94A3B8"><B>0</B></FONT></TD>
        <TD BGCOLOR="#F8FAFC" CELLPADDING="3"><FONT POINT-SIZE="9" COLOR="#64748B">fd7</FONT><BR/><FONT POINT-SIZE="12" COLOR="#94A3B8"><B>0</B></FONT></TD>
        <TD BGCOLOR="#F8FAFC" CELLPADDING="3"><FONT POINT-SIZE="9" COLOR="#64748B">fd8</FONT><BR/><FONT POINT-SIZE="12" COLOR="#94A3B8"><B>0</B></FONT></TD>
        <TD BGCOLOR="#F8FAFC" CELLPADDING="3"><FONT POINT-SIZE="9" COLOR="#64748B">fd9</FONT><BR/><FONT POINT-SIZE="12" COLOR="#94A3B8"><B>0</B></FONT></TD>
        <TD BGCOLOR="#D1FAE5" CELLPADDING="3"><FONT POINT-SIZE="9" COLOR="#0F766E">fd10(cfd)</FONT><BR/><FONT POINT-SIZE="12" COLOR="#0D9488"><B>1</B></FONT></TD>
        <TD BGCOLOR="#F8FAFC" CELLPADDING="3"><FONT POINT-SIZE="9" COLOR="#64748B">…</FONT><BR/><FONT POINT-SIZE="12" COLOR="#94A3B8">…</FONT></TD>
        <TD BGCOLOR="#F8FAFC" CELLPADDING="3"><FONT POINT-SIZE="9" COLOR="#64748B">fd1023</FONT><BR/><FONT POINT-SIZE="12" COLOR="#94A3B8"><B>0</B></FONT></TD>
      </TR>
    </TABLE>
  </TD></TR>
  <TR><TD BGCOLOR="#EEF2FF" ALIGN="CENTER" CELLPADDING="5"><FONT POINT-SIZE="11" COLOR="#3730A3">bit 序号 = fd 编号；绿色 bit=1 表示 FD_SET 置位（关注），灰色 bit=0 表示不关注</FONT></TD></TR>
</TABLE>>];

    s1 [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#4F46E5" COLOR="white" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="13"><B>① 用户态：FD_SET 置位</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#EEF2FF" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="11" COLOR="#3730A3">把关心的 fd（lfd、cfd）对应 bit 置 1</FONT></TD></TR>
</TABLE>>];

    s2 [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#E11D48" COLOR="white" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="13"><B>② select() 系统调用</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#FFF1F2" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="11" COLOR="#BE123C">整个 1024 位位图从用户态拷贝进内核态</FONT></TD></TR>
</TABLE>>];

    s3 [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#0284C7" COLOR="white" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="13"><B>③ 一次事件到来</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#F0F9FF" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="11" COLOR="#0369A1">对端发来数据，cfd 接收缓冲区由「空」变「非空」</FONT></TD></TR>
</TABLE>>];

    s4 [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#E11D48" COLOR="white" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="13"><B>④ 内核遍历 0 ~ maxfd 逐个 poll</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#FFF1F2" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="11" COLOR="#BE123C">对每个 fd 调用它的 poll() 方法，查接收缓冲区是否非空（O(n) 主动扫）</FONT></TD></TR>
</TABLE>>];

    s5 [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#0D9488" COLOR="white" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="13"><B>⑤ 只有 cfd 就绪</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#F0FDFA" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="11" COLOR="#0F766E">内核保留 cfd 的 bit=1，其余 bit 清 0，返回就绪个数</FONT></TD></TR>
</TABLE>>];

    s6 [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#E11D48" COLOR="white" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="13"><B>⑥ 位图拷贝回用户态</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#FFF1F2" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="11" COLOR="#BE123C">select 返回，就绪结果随位图带回</FONT></TD></TR>
</TABLE>>];

    s7 [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#4F46E5" COLOR="white" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="13"><B>⑦ 用户 O(n) 遍历查找</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#EEF2FF" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="11" COLOR="#3730A3">FD_ISSET 逐个检查 bit，找到 cfd 再 read 处理</FONT></TD></TR>
</TABLE>>];

    note [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#D97706" COLOR="white" ALIGN="CENTER" CELLPADDING="7"><FONT POINT-SIZE="12"><B>select 的代价</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#FFFBEB" ALIGN="CENTER" CELLPADDING="7"><FONT POINT-SIZE="11" COLOR="#B45309">位图上限 1024；每次都要<b>全量拷贝</b> + <b>O(n) 主动遍历 poll</b>（内核扫一遍、用户再扫一遍），fd 一多就慢</FONT></TD></TR>
</TABLE>>];

    bitmap -> s1 [style=dashed, color="#4F46E5", fontcolor="#3730A3", label="FD_SET 操作这张位图"];
    s1 -> s2 -> s3 -> s4 -> s5 -> s6 -> s7;
    s7 -> note [style=dashed, color="#D97706", fontcolor="#B45309"];
}
