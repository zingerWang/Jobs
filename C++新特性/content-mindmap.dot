digraph mindmap {
  rankdir=LR;
  dpi=200;
  node [shape=plaintext, fontname="PingFang SC"];
  edge [color="#94A3B8", penwidth=1.6];
  root [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0D9488"><FONT COLOR="white"><B>C++11～C++26 新特性：每个标准在补哪个坑</B></FONT></TD></TR><TR><TD BGCOLOR="#F0FDFA"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#1F2937">按「先遇到什么问题、标准才补了什么」组织</FONT></TD></TR></TABLE></TD></TR></TABLE>>];
  g0 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#4F46E5"><FONT COLOR="white"><B>为什么返回大对象要付两次拷贝</B></FONT></TD></TR></TABLE>>];
  root -> g0;
  g0l0 [label=<<TABLE BORDER="1" COLOR="#4F46E5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#EEF2FF"><FONT COLOR="#1F2937">左值拷贝、右值移动，值类别决定重载</FONT></TD></TR></TABLE>>];
  g0 -> g0l0;
  g0l1 [label=<<TABLE BORDER="1" COLOR="#4F46E5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#EEF2FF"><FONT COLOR="#1F2937">转发引用 + 引用折叠 + std::forward</FONT></TD></TR></TABLE>>];
  g0 -> g0l1;
  g0l2 [label=<<TABLE BORDER="1" COLOR="#4F46E5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#EEF2FF"><FONT COLOR="#1F2937">移动构造不加 noexcept，扩容退化成拷贝</FONT></TD></TR></TABLE>>];
  g0 -> g0l2;
  g1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0D9488"><FONT COLOR="white"><B>为什么资源总要手写 delete</B></FONT></TD></TR></TABLE>>];
  root -> g1;
  g1l0 [label=<<TABLE BORDER="1" COLOR="#0D9488" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#F0FDFA"><FONT COLOR="#1F2937">RAII：析构负责释放，异常路径也不漏</FONT></TD></TR></TABLE>>];
  g1 -> g1l0;
  g1l1 [label=<<TABLE BORDER="1" COLOR="#0D9488" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#F0FDFA"><FONT COLOR="#1F2937">unique_ptr / shared_ptr / weak_ptr 分工</FONT></TD></TR></TABLE>>];
  g1 -> g1l1;
  g1l2 [label=<<TABLE BORDER="1" COLOR="#0D9488" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#F0FDFA"><FONT COLOR="#1F2937">循环引用靠 weak_ptr；计数安全≠对象安全</FONT></TD></TR></TABLE>>];
  g1 -> g1l2;
  g2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white"><B>为什么模板报错读不懂</B></FONT></TD></TR></TABLE>>];
  root -> g2;
  g2l0 [label=<<TABLE BORDER="1" COLOR="#0284C7" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#F0F9FF"><FONT COLOR="#1F2937">static_assert → if constexpr → concepts</FONT></TD></TR></TABLE>>];
  g2 -> g2l0;
  g2l1 [label=<<TABLE BORDER="1" COLOR="#0284C7" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#F0F9FF"><FONT COLOR="#1F2937">concepts 参与重载决议，按约束强弱排序</FONT></TD></TR></TABLE>>];
  g2 -> g2l1;
  g3 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white"><B>为什么同一段逻辑要给每种类型写一遍</B></FONT></TD></TR></TABLE>>];
  root -> g3;
  g3l0 [label=<<TABLE BORDER="1" COLOR="#0284C7" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#F0F9FF"><FONT COLOR="#1F2937">auto 掉引用与 const，decltype 保留值类别</FONT></TD></TR></TABLE>>];
  g3 -> g3l0;
  g3l1 [label=<<TABLE BORDER="1" COLOR="#0284C7" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#F0F9FF"><FONT COLOR="#1F2937">泛型 lambda、捕获初始化、返回类型推导</FONT></TD></TR></TABLE>>];
  g3 -> g3l1;
  g3l2 [label=<<TABLE BORDER="1" COLOR="#0284C7" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#F0F9FF"><FONT COLOR="#1F2937">vector<bool> 的代理类型陷阱</FONT></TD></TR></TABLE>>];
  g3 -> g3l2;
  g4 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0284C7"><FONT COLOR="white"><B>为什么多返回值总是写 out 参数</B></FONT></TD></TR></TABLE>>];
  root -> g4;
  g4l0 [label=<<TABLE BORDER="1" COLOR="#0284C7" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#F0F9FF"><FONT COLOR="#1F2937">结构化绑定拆 pair / tuple / 聚合体</FONT></TD></TR></TABLE>>];
  g4 -> g4l0;
  g4l1 [label=<<TABLE BORDER="1" COLOR="#0284C7" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#F0F9FF"><FONT COLOR="#1F2937">折叠表达式与空参数包的初值</FONT></TD></TR></TABLE>>];
  g4 -> g4l1;
  g4l2 [label=<<TABLE BORDER="1" COLOR="#0284C7" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#F0F9FF"><FONT COLOR="#1F2937">CTAD 与 initializer_list 的歧义</FONT></TD></TR></TABLE>>];
  g4 -> g4l2;
  g5 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#7C3AED"><FONT COLOR="white"><B>为什么表达意图需要新语法</B></FONT></TD></TR></TABLE>>];
  root -> g5;
  g5l0 [label=<<TABLE BORDER="1" COLOR="#7C3AED" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#F5F3FF"><FONT COLOR="#1F2937">optional 可能没有、variant 多选一</FONT></TD></TR></TABLE>>];
  g5 -> g5l0;
  g5l1 [label=<<TABLE BORDER="1" COLOR="#7C3AED" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#F5F3FF"><FONT COLOR="#1F2937">expected 值或错误，单子操作做链式</FONT></TD></TR></TABLE>>];
  g5 -> g5l1;
  g5l2 [label=<<TABLE BORDER="1" COLOR="#7C3AED" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#F5F3FF"><FONT COLOR="#1F2937">deducing this 一份实现覆盖 const/非 const</FONT></TD></TR></TABLE>>];
  g5 -> g5l2;
  g6 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0D9488"><FONT COLOR="white"><B>为什么并发代码每版都要重写</B></FONT></TD></TR></TABLE>>];
  root -> g6;
  g6l0 [label=<<TABLE BORDER="1" COLOR="#0D9488" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#F0FDFA"><FONT COLOR="#1F2937">jthread 自动 join，但析构会阻塞</FONT></TD></TR></TABLE>>];
  g6 -> g6l0;
  g6l1 [label=<<TABLE BORDER="1" COLOR="#0D9488" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#F0FDFA"><FONT COLOR="#1F2937">stop_token 是协作取消，没有安全强杀</FONT></TD></TR></TABLE>>];
  g6 -> g6l1;
  g6l2 [label=<<TABLE BORDER="1" COLOR="#0D9488" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#F0FDFA"><FONT COLOR="#1F2937">atomic wait/notify、latch/barrier/semaphore</FONT></TD></TR></TABLE>>];
  g6 -> g6l2;
  g7 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#7C3AED"><FONT COLOR="white"><B>为什么编译期能做的事越来越多</B></FONT></TD></TR></TABLE>>];
  root -> g7;
  g7l0 [label=<<TABLE BORDER="1" COLOR="#7C3AED" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#F5F3FF"><FONT COLOR="#1F2937">constexpr 是「可以」，consteval 是「必须」</FONT></TD></TR></TABLE>>];
  g7 -> g7l0;
  g7l1 [label=<<TABLE BORDER="1" COLOR="#7C3AED" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#F5F3FF"><FONT COLOR="#1F2937">constinit 消除静态初始化顺序问题</FONT></TD></TR></TABLE>>];
  g7 -> g7l1;
  g7l2 [label=<<TABLE BORDER="1" COLOR="#7C3AED" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#F5F3FF"><FONT COLOR="#1F2937">C++26 反射、契约、pack indexing</FONT></TD></TR></TABLE>>];
  g7 -> g7l2;
  g8 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#E11D48"><FONT COLOR="white"><B>陷阱清单</B></FONT></TD></TR></TABLE>>];
  root -> g8;
  g8l0 [label=<<TABLE BORDER="1" COLOR="#E11D48" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#FFF1F2"><FONT COLOR="#1F2937">string_view 悬垂、auto 推出代理</FONT></TD></TR></TABLE>>];
  g8 -> g8l0;
  g8l1 [label=<<TABLE BORDER="1" COLOR="#E11D48" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#FFF1F2"><FONT COLOR="#1F2937">jthread 阻塞、<=> 不生成 ==</FONT></TD></TR></TABLE>>];
  g8 -> g8l1;
  g8l2 [label=<<TABLE BORDER="1" COLOR="#E11D48" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#FFF1F2"><FONT COLOR="#1F2937">移动不 noexcept 退化为拷贝</FONT></TD></TR></TABLE>>];
  g8 -> g8l2;
  g9 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#475569"><FONT COLOR="white"><B>版本速查</B></FONT></TD></TR></TABLE>>];
  root -> g9;
  g9l0 [label=<<TABLE BORDER="1" COLOR="#475569" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#F8FAFC"><FONT COLOR="#1F2937">每个标准给了什么（语言 + 库）</FONT></TD></TR></TABLE>>];
  g9 -> g9l0;
  g9l1 [label=<<TABLE BORDER="1" COLOR="#475569" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#F8FAFC"><FONT COLOR="#1F2937">减法：auto_ptr、random_shuffle、throw() 已移除</FONT></TD></TR></TABLE>>];
  g9 -> g9l1;
  g10 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#475569"><FONT COLOR="white"><B>验证与表达</B></FONT></TD></TR></TABLE>>];
  root -> g10;
  g10l0 [label=<<TABLE BORDER="1" COLOR="#475569" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#F8FAFC"><FONT COLOR="#1F2937">用 __cpp_* 宏探测实现</FONT></TD></TR></TABLE>>];
  g10 -> g10l0;
  g10l1 [label=<<TABLE BORDER="1" COLOR="#475569" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#F8FAFC"><FONT COLOR="#1F2937">宏有定义 ≠ 能链接、能运行</FONT></TD></TR></TABLE>>];
  g10 -> g10l1;
  g10l2 [label=<<TABLE BORDER="1" COLOR="#475569" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#F8FAFC"><FONT COLOR="#1F2937">面试稿：少拷贝、少样板、少猜意图</FONT></TD></TR></TABLE>>];
  g10 -> g10l2;
  label=<<FONT POINT-SIZE="24" COLOR="#1E293B"><B>C++11～C++26 新特性：一张图看清主线</B></FONT>>;
}