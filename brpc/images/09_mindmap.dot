digraph mindmap_09 {
    rankdir=LR;
    graph [fontname="PingFang SC", bgcolor="white", pad=0.4, nodesep=0.3, ranksep=0.7,
           label=<<FONT POINT-SIZE="22" COLOR="#1E293B"><B>思维导图：IOBuf 的 append 与切包</B></FONT>>,
           labelloc=t, fontname="PingFang SC"];
    node [fontname="PingFang SC", shape=plaintext, margin=0];
    edge [fontname="PingFang SC", fontsize=11, penwidth=1.5, arrowsize=0.8, color="#94A3B8"];

    root [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#475569" COLOR="white" ALIGN="CENTER" CELLPADDING="9"><FONT POINT-SIZE="15"><B>append 与切包</B></FONT></TD></TR>
</TABLE>>];

    s0 [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#334155" COLOR="white" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="12"><B>问题：字节流没有边界</B></FONT></TD></TR>
</TABLE>>];
    s1 [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#0D9488" COLOR="white" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="12"><B>写：append 三档</B></FONT></TD></TR>
</TABLE>>];
    s2 [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#E11D48" COLOR="white" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="12"><B>读：cut 家族</B></FONT></TD></TR>
</TABLE>>];
    s3 [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#4F46E5" COLOR="white" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="12"><B>只读不改：copy/fetch</B></FONT></TD></TR>
</TABLE>>];
    s4 [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#0284C7" COLOR="white" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="12"><B>切包：一行协议解析</B></FONT></TD></TR>
</TABLE>>];
    s5 [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#7C3AED" COLOR="white" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="12"><B>更快 / 更省的替代品</B></FONT></TD></TR>
</TABLE>>];
    s6 [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#D97706" COLOR="white" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="12"><B>边界与坑</B></FONT></TD></TR>
</TABLE>>];

    l0a [label=<<FONT POINT-SIZE="11" COLOR="#1E293B">粘包：一次读到多个包；半包：只读到一部分</FONT>>];
    l0b [label=<<FONT POINT-SIZE="11" COLOR="#BE123C"><B>解析器必须能被反复调用且不改坏数据</B></FONT>>];

    l1a [label=<<FONT POINT-SIZE="11" COLOR="#0F766E"><B>拷贝写</B>：append(数据)/appendv/push_back/resize</FONT>>];
    l1b [label=<<FONT POINT-SIZE="11" COLOR="#0F766E"><B>共享写</B>：append(const IOBuf&amp;) 只加引用计数</FONT>>];
    l1c [label=<<FONT POINT-SIZE="11" COLOR="#0F766E"><B>接管写</B>：append(Movable) 空目标直接 swap</FONT>>];
    l1d [label=<<FONT POINT-SIZE="11" COLOR="#0F766E">append_user_data：包住别人的内存 + 析构回调</FONT>>];

    l2a [label=<<FONT POINT-SIZE="11" COLOR="#BE123C"><B>cutn(&amp;out, n)：切出并追加，零拷贝</B></FONT>>];
    l2b [label=<<FONT POINT-SIZE="11" COLOR="#1E293B">pop_front / pop_back：丢弃，n ≥ len 直接清空</FONT>>];
    l2c [label=<<FONT POINT-SIZE="11" COLOR="#1E293B">cut_until(&amp;out, delim)：按分隔符切，成功返回 0</FONT>>];
    l2d [label=<<FONT POINT-SIZE="11" COLOR="#1E293B">cut1 / fetch1：逐字节读（分隔符扫描用）</FONT>>];

    l3a [label=<<FONT POINT-SIZE="11" COLOR="#4338CA">copy_to(buf, n, pos)：拷进连续内存</FONT>>];
    l3b [label=<<FONT POINT-SIZE="11" COLOR="#4338CA">append_to(IOBuf*)：零拷贝版本，copy_to(IOBuf*) 被编译期拦截</FONT>>];
    l3c [label=<<FONT POINT-SIZE="11" COLOR="#4338CA">fetch/fetch1：能不用拷贝就返回内部指针</FONT>>];
    l3d [label=<<FONT POINT-SIZE="11" COLOR="#4338CA">to_string / copy_to_cstr：图省事的兜底</FONT>>];

    l4a [label=<<FONT POINT-SIZE="11" COLOR="#0369A1">长度前缀：copy_to 头部 → 判长度 → pop_front + cutn</FONT>>];
    l4b [label=<<FONT POINT-SIZE="11" COLOR="#0369A1">分隔符：fetch1 找首字符 → cut_until → 校验</FONT>>];
    l4c [label=<<FONT POINT-SIZE="11" COLOR="#0369A1">NOT_ENOUGH_DATA 分支绝不能改动 source</FONT>>];

    l5a [label=<<FONT POINT-SIZE="11" COLOR="#6D28D9">IOBufCutter：反复从左往右切，避免重复扫描</FONT>>];
    l5b [label=<<FONT POINT-SIZE="11" COLOR="#6D28D9">IOBufBytesIterator：只读遍历，不改变源</FONT>>];
    l5c [label=<<FONT POINT-SIZE="11" COLOR="#6D28D9">IOBufAppender / IOBufBuilder：高频小 append 专用</FONT>>];
    l5d [label=<<FONT POINT-SIZE="11" COLOR="#6D28D9">cut_into_file_descriptor：一条 writev 发出所有块</FONT>>];

    l6a [label=<<FONT POINT-SIZE="11" COLOR="#B45309">cutn 越界会静默夹到 length；pop_front 越界会清空</FONT>>];
    l6b [label=<<FONT POINT-SIZE="11" COLOR="#B45309">cut_until 每次都从头扫 → 反复调用可能 O(n²)</FONT>>];
    l6c [label=<<FONT POINT-SIZE="11" COLOR="#B45309">分隔符最长 sizeof(unsigned long) 字节</FONT>>];
    l6d [label=<<FONT POINT-SIZE="11" COLOR="#B45309">千万不要 buf.append(buf)</FONT>>];
    l6e [label=<<FONT POINT-SIZE="11" COLOR="#B45309">返回值都是 size_t，必须与期望值比对</FONT>>];

    root -> s0; root -> s1; root -> s2; root -> s3; root -> s4; root -> s5; root -> s6;
    s0 -> l0a; s0 -> l0b;
    s1 -> l1a; s1 -> l1b; s1 -> l1c; s1 -> l1d;
    s2 -> l2a; s2 -> l2b; s2 -> l2c; s2 -> l2d;
    s3 -> l3a; s3 -> l3b; s3 -> l3c; s3 -> l3d;
    s4 -> l4a; s4 -> l4b; s4 -> l4c;
    s5 -> l5a; s5 -> l5b; s5 -> l5c; s5 -> l5d;
    s6 -> l6a; s6 -> l6b; s6 -> l6c; s6 -> l6d; s6 -> l6e;
}
