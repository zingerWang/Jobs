  <TR><TD BGCOLOR="#EEF2FF" ALIGN="CENTER" CELLPADDING="5"><FONT POINT-SIZE="10" COLOR="#3730A3">channel.cpp:482　锁 call_id / 设超时 / 序列化请求体</FONT></TD></TR>
</TABLE>>];

    c3 [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#4F46E5" COLOR="white" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="12"><B>3  brpc::Controller::IssueRPC</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#EEF2FF" ALIGN="CENTER" CELLPADDING="5"><FONT POINT-SIZE="10" COLOR="#3730A3">controller.cpp:1315　选 server（SelectServer）→ 拿 socket → 打包 → 写</FONT></TD></TR>
</TABLE>>];

    c4 [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#0284C7" COLOR="white" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="12"><B>4  PackRpcRequest</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#F0F9FF" ALIGN="CENTER" CELLPADDING="5"><FONT POINT-SIZE="10" COLOR="#0369A1">baidu_rpc_protocol.cpp:1097　填 service/method 名、correlation_id（协议插件）</FONT></TD></TR>
</TABLE>>];

    c5 [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#0284C7" COLOR="white" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="12"><B>5  Socket::Write</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#F0F9FF" ALIGN="CENTER" CELLPADDING="5"><FONT POINT-SIZE="10" COLOR="#0369A1">socket.cpp:1643　写进发送队列，真正的发送交给 EventDispatcher 线程</FONT></TD></TR>
</TABLE>>];

    // ===== 服务端 =====
