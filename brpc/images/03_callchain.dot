digraph callchain {
    rankdir=TB;
    graph [fontname="PingFang SC", bgcolor="white", pad=0.5, nodesep=0.8, ranksep=0.42, label=<<FONT POINT-SIZE="24" COLOR="#1E293B"><B>一次 RPC 的关键函数调用链（echo 例子）</B></FONT><BR/><FONT POINT-SIZE="13" COLOR="#64748B">左列 = echo_client，右列 = echo_server；括号里的 文件:行号 是本系列后续跟源码的「索引」</FONT>>, labelloc=t, fontname="PingFang SC"];
    node [fontname="PingFang SC", shape=plaintext, margin=0];
    edge [fontname="PingFang SC", fontsize=11, penwidth=1.6, arrowsize=0.8];

    // ===== 客户端 =====
    c1 [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#4F46E5" COLOR="white" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="12"><B>1  stub.Echo(&amp;cntl,&amp;req,&amp;resp,nullptr)</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#EEF2FF" ALIGN="CENTER" CELLPADDING="5"><FONT POINT-SIZE="10" COLOR="#3730A3">protobuf 生成的 EchoService_Stub（echo.pb.cc，<B>不在 bRPC 仓库里</B>）</FONT></TD></TR>
</TABLE>>];

    c2 [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
