</TABLE>>];

    s9 [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#E11D48" COLOR="white" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="12"><B>9  svc-&gt;CallMethod(...) → 你的 Echo()</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#FFF1F2" ALIGN="CENTER" CELLPADDING="5"><FONT POINT-SIZE="10" COLOR="#BE123C">baidu_rpc_protocol.cpp:875 调进来，落到 example/echo_c++/server.cpp:42 的 <B>EchoServiceImpl::Echo</B></FONT></TD></TR>
</TABLE>>];

    s10 [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#0D9488" COLOR="white" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="12"><B>10  done-&gt;Run() = SendRpcResponse</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#F0FDFA" ALIGN="CENTER" CELLPADDING="5"><FONT POINT-SIZE="10" COLOR="#0F766E">由 ClosureGuard 析构触发（closure_guard.h）→ baidu_rpc_protocol.cpp:288 组响应回包</FONT></TD></TR>
</TABLE>>];

    note [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#D97706" COLOR="white" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="12"><B>同步调用的那一半：brpc::Join(correlation_id)</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#FFFBEB" ALIGN="CENTER" CELLPADDING="5"><FONT POINT-SIZE="10" COLOR="#B45309">controller.cpp:827　done == nullptr 时，Channel::CallMethod 最后会 Join —— 当前 <B>bthread</B> 在此挂起，<BR/>等响应回来后被 <B>bthread_id_error</B> 唤醒（第 03 篇第 4 节详解）</FONT></TD></TR>
</TABLE>>];

    { rank=same; c1; s6; }
    { rank=same; c2; s7; }
    { rank=same; c3; s8; }
    { rank=same; c4; s9; }
    { rank=same; c5; s10; }

