digraph barriers {
    rankdir=TB;
    graph [fontname="PingFang SC", bgcolor="white", pad=0.5, nodesep=0.6, ranksep=0.7, label=<<FONT POINT-SIZE="24" COLOR="#1E293B"><B>新手看 bRPC 源码的三个坎</B></FONT><BR/><FONT POINT-SIZE="13" COLOR="#64748B">被「劝退」通常不是因为难，而是因为不认识这些「方言」——认熟了，源码就好读了</FONT>>, labelloc=t, fontname="PingFang SC"];
    node [fontname="PingFang SC", shape=plaintext, margin=0];
    edge [fontname="PingFang SC", fontsize=12, penwidth=1.8, arrowsize=0.8];

    q [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#475569" COLOR="white" ALIGN="CENTER" CELLPADDING="8"><FONT POINT-SIZE="14"><B>「这段代码我怎么看不懂？」</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#F8FAFC" ALIGN="CENTER" CELLPADDING="7"><FONT POINT-SIZE="11" COLOR="#334155">其实只是没认出它属于哪个惯用法家族</FONT></TD></TR>
</TABLE>>];

    b1 [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#E11D48" COLOR="white" ALIGN="CENTER" CELLPADDING="8"><FONT POINT-SIZE="14"><B>坎一：宏与日志</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#FFF1F2" ALIGN="LEFT" CELLPADDING="8"><FONT POINT-SIZE="11" COLOR="#BE123C">LOG / CHECK / DCHECK / PLOG / VLOG<BR/>BAIDU_CASSERT / BAIDU_LIKELY / BAIDU_SCOPED_LOCK<BR/>DEFINE_* / DECLARE_*（gflags）<BR/><B>不认识就以为是什么魔法语法</B></FONT></TD></TR>
</TABLE>>];

    b2 [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#0284C7" COLOR="white" ALIGN="CENTER" CELLPADDING="8"><FONT POINT-SIZE="14"><B>坎二：自造的基础类型</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#F0F9FF" ALIGN="LEFT" CELLPADDING="8"><FONT POINT-SIZE="11" COLOR="#0369A1">butil::Status（替代 bool + errno）<BR/>butil::EndPoint（IP + 端口）<BR/>butil::StringPiece（不拥有的字符串视图）<BR/>butil::IOBuf（不是 STL，是零拷贝缓冲）</FONT></TD></TR>
</TABLE>>];

    b3 [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#0D9488" COLOR="white" ALIGN="CENTER" CELLPADDING="8"><FONT POINT-SIZE="14"><B>坎三：所有权与生命周期惯用法</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#F0FDFA" ALIGN="LEFT" CELLPADDING="8"><FONT POINT-SIZE="11" COLOR="#0F766E">SocketUniquePtr（引用计数的智能指针）<BR/>Closure / NewCallback / done-&gt;Run()<BR/>ClosureGuard（RAII 保证 done 一定被 Run）<BR/>ChannelOwnership（谁负责 delete）</FONT></TD></TR>
</TABLE>>];

    out [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#7C3AED" COLOR="white" ALIGN="CENTER" CELLPADDING="8"><FONT POINT-SIZE="14"><B>过了三坎：源码从「天书」变成「方言」</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#F5F3FF" ALIGN="CENTER" CELLPADDING="7"><FONT POINT-SIZE="11" COLOR="#6D28D9">每个惯用法问三句：长什么样 → 为什么这么写 → 在哪见过</FONT></TD></TR>
</TABLE>>];

    q -> b1 [color="#E11D48", fontcolor="#BE123C"];
    q -> b2 [color="#0284C7", fontcolor="#0369A1"];
    q -> b3 [color="#0D9488", fontcolor="#0F766E"];
    b1 -> out [color="#94A3B8"];
    b2 -> out [color="#94A3B8"];
    b3 -> out [color="#94A3B8"];
}
