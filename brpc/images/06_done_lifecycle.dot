digraph done_lifecycle {
    rankdir=TB;
    compound=true;
    graph [fontname="PingFang SC", bgcolor="white", pad=0.5, nodesep=0.6, ranksep=0.55, label=<<FONT POINT-SIZE="24" COLOR="#1E293B"><B>一次调用里 done 的一生</B></FONT><BR/><FONT POINT-SIZE="13" COLOR="#64748B">done == nullptr 是同步调用；done != nullptr 是异步回调 —— 同一个函数，两种语义</FONT>>, labelloc=t, fontname="PingFang SC"];
    node [fontname="PingFang SC", shape=plaintext, margin=0];
    edge [fontname="PingFang SC", fontsize=11.5, penwidth=1.8, arrowsize=0.8];

    subgraph cluster_sync {
        label=<<FONT POINT-SIZE="15" COLOR="#0F766E"><B>同步路径：done == nullptr</B></FONT>>;
        fontname="PingFang SC"; color="#0D9488"; style="rounded"; penwidth=2;
        s1 [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#4F46E5" COLOR="white" ALIGN="CENTER" CELLPADDING="7"><FONT POINT-SIZE="12"><B>用户：stub.Echo(&amp;cntl, &amp;req, &amp;resp, nullptr)</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#EEF2FF" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="10.5" COLOR="#3730A3">栈上变量即可，函数返回时对象还活着</FONT></TD></TR>
</TABLE>>];
        s2 [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#0284C7" COLOR="white" ALIGN="CENTER" CELLPADDING="7"><FONT POINT-SIZE="12"><B>Channel::CallMethod → IssueRPC</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#F0F9FF" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="10.5" COLOR="#0369A1">channel.cpp:482　　controller.cpp:1316（IssueRPC）</FONT></TD></TR>
</TABLE>>];
        s3 [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#E11D48" COLOR="white" ALIGN="CENTER" CELLPADDING="7"><FONT POINT-SIZE="12"><B>Channel::Join(correlation_id) 阻塞</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#FFF1F2" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="10.5" COLOR="#BE123C">channel.cpp:658　挂起 bthread，让出 worker</FONT></TD></TR>
</TABLE>>];
        s4 [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#7C3AED" COLOR="white" ALIGN="CENTER" CELLPADDING="7"><FONT POINT-SIZE="12"><B>被唤醒 → 检查 cntl.Failed()</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#F5F3FF" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="10.5" COLOR="#6D28D9">controller.cpp:1253 else 分支：不调 _done，只解锁</FONT></TD></TR>
</TABLE>>];
    }

    subgraph cluster_async {
        label=<<FONT POINT-SIZE="15" COLOR="#BE123C"><B>异步路径：done != nullptr</B></FONT>>;
        fontname="PingFang SC"; color="#E11D48"; style="rounded"; penwidth=2;
        a1 [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#4F46E5" COLOR="white" ALIGN="CENTER" CELLPADDING="7"><FONT POINT-SIZE="12"><B>done = brpc::NewCallback(&amp;HandleEchoResponse, cntl, resp)</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#EEF2FF" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="10.5" COLOR="#3730A3">cntl / resp 必须 new 在堆上，活到回调被调用</FONT></TD></TR>
</TABLE>>];
        a2 [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#0284C7" COLOR="white" ALIGN="CENTER" CELLPADDING="7"><FONT POINT-SIZE="12"><B>CallMethod 发出请求后立即返回</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#F0F9FF" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="10.5" COLOR="#0369A1">channel.h:221 注释：返回时可能 done 已被调用过</FONT></TD></TR>
</TABLE>>];
        a3 [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#E11D48" COLOR="white" ALIGN="CENTER" CELLPADDING="7"><FONT POINT-SIZE="12"><B>Controller::OnVersionedRpcReturned → _done-&gt;Run()</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#FFF1F2" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="10.5" COLOR="#BE123C">controller.cpp:1237　回调里读 cntl-&gt;Failed() / response</FONT></TD></TR>
</TABLE>>];
    }

    note [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#D97706" COLOR="white" ALIGN="CENTER" CELLPADDING="7"><FONT POINT-SIZE="12"><B>最容易踩的坑</B></FONT></TD></TR>
  <TR><TD BGCOLOR="#FFFBEB" ALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="10.5" COLOR="#B45309">1. done == NULL 时不要在别处再 Run 它（根本没有）<BR/>2. 异步时把 cntl/req/resp 建在栈上 → 回调触发时已悬空<BR/>3. brpc::DoNothing() 是非 NULL 的 Closure → 它属于「异步」语义</FONT></TD></TR>
</TABLE>>];

    s1 -> s2 [color="#0D9488", fontcolor="#0F766E"];
    s2 -> s3 [color="#0D9488", fontcolor="#0F766E"];
    s3 -> s4 [color="#0D9488", fontcolor="#0F766E"];
    a1 -> a2 [color="#E11D48", fontcolor="#BE123C"];
    a2 -> a3 [color="#E11D48", fontcolor="#BE123C", label="网络往返"];
}
