digraph mindmap_05 {
    rankdir=LR;
    graph [fontname="PingFang SC", bgcolor="white", pad=0.4, nodesep=0.35, ranksep=0.7, label=<<FONT POINT-SIZE="22" COLOR="#1E293B"><B>思维导图：bRPC 的编码风格与惯用法</B></FONT>>, labelloc=t, fontname="PingFang SC"];
    node [fontname="PingFang SC", shape=plaintext, margin=0];
    edge [fontname="PingFang SC", fontsize=11, penwidth=1.5, arrowsize=0.8, color="#94A3B8"];

    root [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#475569" COLOR="white" ALIGN="CENTER" CELLPADDING="9"><FONT POINT-SIZE="15"><B>不被源码劝退的速查手册</B></FONT></TD></TR>
</TABLE>>];

    s0 [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#334155" COLOR="white" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="12"><B>为什么要先认惯用法</B></FONT></TD></TR>
</TABLE>>];
    s1 [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#E11D48" COLOR="white" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="12"><B>日志与检查</B></FONT></TD></TR>
</TABLE>>];
    s2 [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#4F46E5" COLOR="white" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="12"><B>gflags 与工具宏</B></FONT></TD></TR>
</TABLE>>];
    s3 [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#0284C7" COLOR="white" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="12"><B>基础值类型</B></FONT></TD></TR>
</TABLE>>];
    s4 [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#0D9488" COLOR="white" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="12"><B>所有权与回调</B></FONT></TD></TR>
</TABLE>>];
    s5 [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
  <TR><TD BGCOLOR="#7C3AED" COLOR="white" ALIGN="CENTER" CELLPADDING="6"><FONT POINT-SIZE="12"><B>陷阱（最重要）</B></FONT></TD></TR>
</TABLE>>];

    l0a [label=<<FONT POINT-SIZE="11" COLOR="#1E293B">新手三坎：宏 / 自造类型 / 所有权</FONT>>];
    l0b [label=<<FONT POINT-SIZE="11" COLOR="#0F766E"><B>三段式：长什么样 → 为什么 → 在哪见过</B></FONT>>];

    l1a [label=<<FONT POINT-SIZE="11" COLOR="#BE123C">LOG / LOG_IF / VLOG / PLOG（logging.h）</FONT>>];
    l1b [label=<<FONT POINT-SIZE="11" COLOR="#1E293B"><B>CHECK 始终生效，DCHECK 仅 debug</B></FONT>>];
    l1c [label=<<FONT POINT-SIZE="11" COLOR="#1E293B">CHECK(st.ok()) &lt;&lt; st —— 可流式输出</FONT>>];

    l2a [label=<<FONT POINT-SIZE="11" COLOR="#4338CA">DEFINE_* 定义，DECLARE_* 引用</FONT>>];
    l2b [label=<<FONT POINT-SIZE="11" COLOR="#1E293B">BRPC_VALIDATE_GFLAG → 可热更新</FONT>>];
    l2c [label=<<FONT POINT-SIZE="11" COLOR="#1E293B">DISALLOW_COPY_AND_ASSIGN / BAIDU_CASSERT</FONT>>];

    l3a [label=<<FONT POINT-SIZE="11" COLOR="#0369A1"><B>butil::Status：ok() / error_cstr()</B></FONT>>];
    l3b [label=<<FONT POINT-SIZE="11" COLOR="#1E293B">butil::EndPoint：endpoint2str 打印</FONT>>];
    l3c [label=<<FONT POINT-SIZE="11" COLOR="#1E293B">butil::StringPiece：只引用，不拥有</FONT>>];
    l3d [label=<<FONT POINT-SIZE="11" COLOR="#1E293B">butil::StringPrintf / string_printf</FONT>>];

    l4a [label=<<FONT POINT-SIZE="11" COLOR="#0F766E"><B>SocketUniquePtr = 带引用计数的 unique_ptr</B></FONT>>];
    l4b [label=<<FONT POINT-SIZE="11" COLOR="#1E293B">Closure = protobuf 的回调接口</FONT>>];
    l4c [label=<<FONT POINT-SIZE="11" COLOR="#1E293B">ClosureGuard：RAII，析构必 Run</FONT>>];
    l4d [label=<<FONT POINT-SIZE="11" COLOR="#1E293B">ChannelOwnership：OWNS / DOESNT_OWN</FONT>>];

    l5a [label=<<FONT POINT-SIZE="11" COLOR="#6D28D9"><B>bthread 里别用 usleep / pthread 锁</B></FONT>>];
    l5b [label=<<FONT POINT-SIZE="11" COLOR="#6D28D9"><B>IOBuf ≠ STL string（别按 STL 语义用）</B></FONT>>];
    l5c [label=<<FONT POINT-SIZE="11" COLOR="#6D28D9">StringPiece 生命周期不能超过源字符串</FONT>>];
    l5d [label=<<FONT POINT-SIZE="11" COLOR="#6D28D9">Closure 执行后自删除，别 Run 两次</FONT>>];

    root -> s0; root -> s1; root -> s2; root -> s3; root -> s4; root -> s5;
    s0 -> l0a; s0 -> l0b;
    s1 -> l1a; s1 -> l1b; s1 -> l1c;
    s2 -> l2a; s2 -> l2b; s2 -> l2c;
    s3 -> l3a; s3 -> l3b; s3 -> l3c; s3 -> l3d;
    s4 -> l4a; s4 -> l4b; s4 -> l4c; s4 -> l4d;
    s5 -> l5a; s5 -> l5b; s5 -> l5c; s5 -> l5d;
}
