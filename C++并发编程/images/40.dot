digraph G {
graph [rankdir=LR, dpi=200, bgcolor="white", pad="0.35", nodesep="0.22", ranksep="0.5", fontname="PingFang SC", labelloc=t, labeljust=c];
node [shape=plaintext, fontname="PingFang SC", fontsize=13];
edge [arrowsize=0.65];
label=<<FONT COLOR="#1E293B" POINT-SIZE="24"><B>内存回收方案</B></FONT><BR/><FONT COLOR="#64748B" POINT-SIZE="13">第 40 篇 · 工程问题、机制推导与验证边界</FONT>>;
root [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#475569"><FONT COLOR="white"><B>第 40 篇</B></FONT></TD></TR><TR><TD BGCOLOR="#F8FAFC"><FONT COLOR="#334155" POINT-SIZE="11">内存回收方案：Hazard Pointer 与<BR/>Epoch-Based Reclamation 的原理和取舍</FONT></TD></TR></TABLE>>];
b0 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#4F46E5"><FONT COLOR="white"><B>回收阶段</B></FONT></TD></TR><TR><TD BGCOLOR="#EEF2FF"><FONT COLOR="#334155" POINT-SIZE="11">摘链、退休、真正销毁 / ABA 与对象保<BR/>活是不同义务</FONT></TD></TR></TABLE>>];
root -> b0 [color="#4F46E5"];
b1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0D9488"><FONT COLOR="white"><B>Hazard Pointer</B></FONT></TD></TR><TR><TD BGCOLOR="#F0FDFA"><FONT COLOR="#334155" POINT-SIZE="11">公布保护后重新验证 / 扫描槽位决定候<BR/>选回收</FONT></TD></TR></TABLE>>];
root -> b1 [color="#0D9488"];
b2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#D97706"><FONT COLOR="white"><B>Epoch 回收</B></FONT></TD></TR><TR><TD BGCOLOR="#FFFBEB"><FONT COLOR="#334155" POINT-SIZE="11">进入前登记，退出报静止 / 停滞读者可<BR/>能拖住整批节点</FONT></TD></TR></TABLE>>];
root -> b2 [color="#D97706"];
b3 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#7C3AED"><FONT COLOR="white"><B>受控证明</B></FONT></TD></TR><TR><TD BGCOLOR="#F5F3FF"><FONT COLOR="#334155" POINT-SIZE="11">保留受保护节点再安全释放 / 单读者模<BR/>型不冒充通用库</FONT></TD></TR></TABLE>>];
root -> b3 [color="#7C3AED"];
}
