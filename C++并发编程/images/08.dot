digraph G {
graph [rankdir=LR, dpi=200, bgcolor="white", pad="0.35", nodesep="0.22", ranksep="0.5", fontname="PingFang SC", labelloc=t, labeljust=c];
node [shape=plaintext, fontname="PingFang SC", fontsize=13];
edge [arrowsize=0.65];
label=<<FONT COLOR="#1E293B" POINT-SIZE="24"><B>并发 Bug 排查手段</B></FONT><BR/><FONT COLOR="#64748B" POINT-SIZE="13">第 08 篇 · 工程问题、机制推导与验证边界</FONT>>;
root [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#475569"><FONT COLOR="white"><B>第 08 篇</B></FONT></TD></TR><TR><TD BGCOLOR="#F8FAFC"><FONT COLOR="#334155" POINT-SIZE="11">并发 Bug 排查手段：GDB 多线程调试、<BR/>core 分析与竞态复现</FONT></TD></TR></TABLE>>];
b0 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#4F46E5"><FONT COLOR="white"><B>证据分类</B></FONT></TD></TR><TR><TD BGCOLOR="#EEF2FF"><FONT COLOR="#334155" POINT-SIZE="11">崩溃现场与匹配符号 / 等待环与业务守<BR/>恒</FONT></TD></TR></TABLE>>];
root -> b0 [color="#4F46E5"];
b1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#0D9488"><FONT COLOR="white"><B>GDB 调试</B></FONT></TD></TR><TR><TD BGCOLOR="#F0FDFA"><FONT COLOR="#334155" POINT-SIZE="11">线程切换和条件断点 / 调度锁定会改变<BR/>执行</FONT></TD></TR></TABLE>>];
root -> b1 [color="#0D9488"];
b2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#D97706"><FONT COLOR="white"><B>core 分析</B></FONT></TD></TR><TR><TD BGCOLOR="#FFFBEB"><FONT COLOR="#334155" POINT-SIZE="11">全线程快照不含完整历史 / 从栈顶追到<BR/>对象所有权</FONT></TD></TR></TABLE>>];
root -> b2 [color="#D97706"];
b3 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD BGCOLOR="#7C3AED"><FONT COLOR="white"><B>受控复现</B></FONT></TD></TR><TR><TD BGCOLOR="#F5F3FF"><FONT COLOR="#334155" POINT-SIZE="11">barrier 固定检查窗口 / 默认安全反例<BR/>与可选故障模式</FONT></TD></TR></TABLE>>];
root -> b3 [color="#7C3AED"];
}
